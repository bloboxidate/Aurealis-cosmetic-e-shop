<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div style="background-color:#fff9f3;min-height:100vh;display:flex;flex-direction:column;background-image:
    radial-gradient(700px circle at 20% 15%, rgba(165,209,228,.5), transparent 60%),
    radial-gradient(650px circle at 85% 80%, rgba(191,181,232,.5), transparent 58%)">
  <div style="padding:32px 64px"><a href="/" style="display:flex;align-items:center;width:fit-content"><img src="/assets/aurealis-logo-black.webp" alt="Auréalis" style="height:56px;width:auto;display:block"></a></div>
  <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px">
    <div class="serif" style="font-size:56px;margin-bottom:12px"><%= heading %></div>
    <div style="font-size:16px;color:#6b6357;max-width:420px;margin-bottom:28px"><%= message %></div>
    <a class="au-link btn-primary" href="/">Back to Home</a>
  </div>
</div>
</body>
</html>
