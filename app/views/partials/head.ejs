<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- This site is light-themed only (no dark styles exist) — without this,
     some mobile browsers auto-darken/invert pages that don't declare a
     color-scheme when the OS is in dark mode, which is what was making
     near-white elements (category chips, etc.) render dark on phones. -->
<meta name="color-scheme" content="light only">
<% var _motion = (typeof noMotion === 'undefined' || !noMotion); var _av = (typeof assetV !== 'undefined' ? assetV : '1'); %>
<% if (_motion && typeof home !== 'undefined' && home && home.hero_image) { %>
<!-- The hero image is the LCP element: fetch it at top priority, before CSS/JS discovery. -->
<link rel="preload" as="image" href="<%= home.hero_image %>" fetchpriority="high">
<% } %>
<title><%= typeof title !== 'undefined' ? title : 'Auréalis' %></title>
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
<link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box}
  body{margin:0;font-family:'Manrope',sans-serif;color:#3a352e}
  a.au-link{text-decoration:none;transition:opacity .15s ease}
  a.au-link:hover{opacity:.7}
  .serif{font-family:'Cormorant Garamond',serif}
  .rich{font-size:15px;line-height:1.8;color:#4a453d}
  .rich p{margin:0 0 18px}
  .rich h2{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:28px;line-height:1.2;margin:34px 0 10px;color:#3a352e}
  .rich h3{font-size:16px;font-weight:700;margin:24px 0 8px;color:#3a352e}
  .rich > :first-child{margin-top:0}
  .rich ul{margin:0 0 18px;padding-left:22px}
  .rich li{margin-bottom:6px}
  .rich a{color:#c1602f;text-decoration:underline}
  button{font-family:inherit}
  input,select,textarea{font-family:'Manrope',sans-serif}
  .btn-primary{display:inline-block;text-align:center;background:#f8ae7f;color:#3a2317;padding:16px 34px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;border-radius:100px;border:none;cursor:pointer;position:relative;overflow:hidden;isolation:isolate;transition:transform .5s cubic-bezier(.16,1,.3,1),box-shadow .6s cubic-bezier(.16,1,.3,1),opacity .3s ease}
  .btn-primary:hover{box-shadow:0 10px 28px rgba(248,174,127,.38)}
  .btn-primary:active{transform:translateY(0) scale(.98)}
  .btn-outline{display:inline-block;text-align:center;border:1px solid rgba(58,53,46,.3);padding:14px 28px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#3a352e;border-radius:100px;background:transparent;cursor:pointer;transition:background-color .5s cubic-bezier(.16,1,.3,1),color .5s cubic-bezier(.16,1,.3,1),transform .3s ease}
  .btn-outline:hover{background:#3a352e;color:#fff9f3}
  .btn-outline:active{transform:translateY(0) scale(.98)}
  /* Product cards: gentle lift + image zoom on hover, tactile press states.
     cubic-bezier(.22,1,.36,1) ("ease-out-expo") decelerates smoothly with no
     mechanical snap, and a longer duration reads as glide rather than jump. */
  .product-card{position:relative}
  .product-card img{transition:transform 1.4s cubic-bezier(.16,1,.3,1)}
  /* Hover-only lift/zoom, gated to real pointers. Touch browsers fake a
     hover state on the first tap of anything a :hover rule matches, which
     eats that tap and forces a second one to actually follow the link —
     ungating this made "open a product" need a double-tap on phones. */
  @media (hover:hover) and (pointer:fine) {
    .product-card:hover img{transform:scale(1.035)}
  }
  /* Toast (bottom-right, slides + fades in) */
  .au-toast{position:fixed;bottom:28px;right:28px;background:#3a352e;color:#fff9f3;padding:14px 20px;border-radius:12px;display:flex;align-items:center;gap:10px;font-size:14px;font-weight:600;box-shadow:0 14px 34px rgba(0,0,0,.25);z-index:200;transform:translateY(12px);opacity:0;pointer-events:none;transition:transform .6s cubic-bezier(.16,1,.3,1),opacity .4s ease}
  .au-toast svg{flex:none;color:#a5bf97}
  .au-toast.au-toast-show{transform:translateY(0);opacity:1}
  /* Product card interactions — quick-add icon reveals on hover with a pop-in,
     and both add buttons pulse green on a successful add so it's obvious
     something happened. */
  .product-card-quick-add{opacity:0;transform:translateY(-4px);transition:opacity .5s cubic-bezier(.16,1,.3,1),transform .5s cubic-bezier(.16,1,.3,1),background-color .3s ease}
  @media (hover:hover) and (pointer:fine) {
    .product-card:hover .product-card-quick-add,.product-card:focus-within .product-card-quick-add{opacity:1;transform:translateY(0)}
  }
  /* No real hover on touch — there's nothing to "reveal" it on, so just show
     it plainly instead of leaving it permanently hidden/undiscoverable. */
  @media (hover:none), (pointer:coarse) {
    .product-card-quick-add{opacity:1;transform:none}
  }
  .product-card-quick-add:hover{background:#f8ae7f}
  .product-card-quick-add:active{transform:scale(.95)}
  .product-card-add{transition:background-color .5s cubic-bezier(.16,1,.3,1),color .5s cubic-bezier(.16,1,.3,1),transform .2s ease}
  .product-card-add:hover{background:#3a352e;color:#fff9f3}
  /* Wishlist heart — always visible (unlike the cart quick-add) since there's
     no equivalent always-visible fallback control on the card for it. */
  .product-card-wishlist{width:40px;height:40px;padding:0;border-radius:50%;background:#fff9f3;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(58,53,46,.18);transition:background-color .4s cubic-bezier(.16,1,.3,1),transform .4s cubic-bezier(.16,1,.3,1)}
  .product-card-wishlist:hover{background:#f8ae7f;transform:scale(1.04)}
  .product-card-wishlist:active{transform:scale(.94)}
  .product-card-add:active{transform:scale(.97)}
  @keyframes au-added-pulse{
    0%{transform:scale(1)}
    35%{transform:scale(1.08)}
    100%{transform:scale(1)}
  }
  .au-added{animation:au-added-pulse .7s cubic-bezier(.16,1,.3,1);background-color:#a5bf97 !important;color:#2f4a26 !important;border-color:#a5bf97 !important}
  .field{width:100%;padding:14px 16px;border-radius:10px;border:1px solid rgba(58,53,46,.25);font-size:14px;background:#fff}
  .field:focus{outline:none;border-color:#c1602f}
  .flash{max-width:none;padding:14px 64px;font-size:14px}
  .flash-success{background:rgba(165,191,151,.35);color:#2f4a26}
  .flash-error{background:rgba(248,174,127,.35);color:#8a3d16}
  img{max-width:100%}
  /* Images fill their frame ("zoom to fit"): frames size themselves with
     aspect-ratio so they scale on every screen, and the image covers the frame. */
  .img-frame img,.pdp-main img,.pdp-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  /* Rotating product strip (home) — continuous marquee, two identical sets so
     translating -50% loops seamlessly. */
  .prod-strip{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}
  .prod-strip-track{display:flex;width:max-content;will-change:transform;animation:au-marquee 60s linear infinite}
  .prod-strip:hover .prod-strip-track,.prod-strip:focus-within .prod-strip-track{animation-play-state:paused}
  .prod-strip-set{display:flex;gap:20px;padding-right:20px}
  .prod-strip-item{display:block;flex:none;width:clamp(150px,22vw,240px);color:inherit;text-decoration:none}
  .prod-strip-img{aspect-ratio:4/5;border-radius:16px;overflow:hidden;margin-bottom:10px}
  .prod-strip-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1.4s cubic-bezier(.16,1,.3,1)}
  .prod-strip-name{font-size:14px;font-weight:700;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .prod-strip-price{font-size:13px;color:#8a8175}
  @media (hover:hover) and (pointer:fine){.prod-strip-item:hover .prod-strip-img img{transform:scale(1.035)}}
  @keyframes au-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  /* Admin-formatted short copy under page titles (centred) */
  .rich-center{max-width:620px;margin:18px auto 0;text-align:center;font-size:16px;color:#6b6357;line-height:1.6}
  .rich-center p{margin:0 0 10px}
  /* Hamburger menu (CSS-only) — used at all viewport widths, not just mobile */
  /* Visually hidden, not display:none — the checkbox must stay focusable so the
     menus work from the keyboard (Space toggles). Focus ring is in motion.css. */
  .nav-check{position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
  .nav-burger{display:flex;flex-direction:column;justify-content:center;gap:5px;width:36px;height:36px;cursor:pointer;flex:none}
  /* Hamburger → X morph: a little overshoot on the rotation (spring-like
     cubic-bezier) plus the middle bar shrinking away, not just fading, so
     the change reads as an animated transformation rather than a jump-cut. */
  .nav-burger span{display:block;height:2px;width:24px;background:#3a352e;border-radius:2px;transition:transform .55s cubic-bezier(.76,0,.24,1),opacity .3s ease}
  .nav-check:checked ~ .nav-burger span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .nav-check:checked ~ .nav-burger span:nth-child(2){opacity:0;transform:scale(0)}
  .nav-check:checked ~ .nav-burger span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .nav-mobile,.admin-nav-mobile{display:none;position:absolute;top:100%;left:0;right:0;background:#fff9f3;flex-direction:column;padding:4px 22px 14px;z-index:60;border-bottom:1px solid rgba(58,53,46,.12);box-shadow:0 12px 26px rgba(58,53,46,.14)}
  .nav-mobile a,.nav-mobile-logout,.admin-nav-mobile a{display:block;width:100%;text-align:left;padding:14px 2px;font-size:15px;color:#3a352e;text-decoration:none;border:none;border-bottom:1px solid rgba(58,53,46,.07);background:none;cursor:pointer;font-family:inherit;letter-spacing:.02em}
  .nav-mobile a:last-of-type,.admin-nav-mobile a:last-of-type{border-bottom:none}
  .admin-nav-mobile{background:#3a352e;box-shadow:0 12px 26px rgba(0,0,0,.25)}
  .admin-nav-mobile a{color:rgba(244,241,234,.85);border-bottom-color:rgba(244,241,234,.1)}
  .admin-burger span{background:#f4f1ea}
  @keyframes au-drop-in{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
  .nav-check:checked ~ .nav-mobile,.nav-check:checked ~ .admin-nav-mobile{display:flex !important;animation:au-drop-in .5s cubic-bezier(.16,1,.3,1)}
  /* Account dropdown (right side, both viewports) */
  .account-dropdown{display:none;position:absolute;top:100%;right:0;margin-top:10px;background:#fff9f3;flex-direction:column;min-width:190px;padding:6px 0;z-index:60;border-radius:12px;border:1px solid rgba(58,53,46,.12);box-shadow:0 12px 26px rgba(58,53,46,.14)}
  .account-dropdown a,.account-dropdown-logout{display:block;width:100%;text-align:left;padding:11px 18px;font-size:14px;color:#3a352e;text-decoration:none;border:none;background:none;cursor:pointer;font-family:inherit}
  .account-dropdown a:hover,.account-dropdown-logout:hover{background:rgba(58,53,46,.06)}
  .nav-check:checked ~ .account-dropdown{display:flex;animation:au-drop-in .5s cubic-bezier(.16,1,.3,1)}
  /* Product page gallery: uniform thumbnail column on the left, big image on
     the right with prev/next arrows over it. */
  .pdp-gallery{display:flex;gap:16px}
  .pdp-thumbs{display:flex;flex-direction:column;gap:12px;flex:none}
  .pdp-thumb{width:88px;height:88px;border-radius:12px;overflow:hidden;cursor:pointer;flex:none;border:2px solid transparent;transition:border-color .5s cubic-bezier(.16,1,.3,1),opacity .5s cubic-bezier(.16,1,.3,1);opacity:.75}
  .pdp-thumb:hover{opacity:1}
  .pdp-thumb-active{border-color:#c1602f;opacity:1}
  .pdp-main{position:relative;flex:1;min-width:0;aspect-ratio:1/1;max-height:640px;border-radius:20px;overflow:hidden}
  .pdp-main img{transition:opacity .22s ease}
  .pdp-arrow{position:absolute;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:50%;border:none;background:rgba(255,249,243,.92);cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(58,53,46,.18);transition:background-color .4s cubic-bezier(.16,1,.3,1),transform .4s cubic-bezier(.16,1,.3,1);z-index:2}
  .pdp-arrow-prev{left:16px}
  .pdp-arrow-next{right:16px}
  @media (hover:hover) and (pointer:fine) {
    .pdp-arrow:hover{background:#f8ae7f;transform:translateY(-50%) scale(1.04)}
  }
  .pdp-arrow:active{transform:translateY(-50%) scale(.94)}
  @media(max-width:820px){
    .pdp-gallery{flex-direction:column}
    .pdp-thumbs{flex-direction:row;overflow-x:auto;order:2;padding-top:4px}
    .pdp-main{order:1;max-height:none}
    /* Explicit opaque background so the (dark) logo/hamburger/icons always
       have reliable contrast on mobile, regardless of whatever's behind the
       header on a given page (hero gradients etc.) — the header itself has
       no background otherwise, just a border. */
    .au-header{padding:14px 22px !important;flex-wrap:wrap;gap:10px 18px;background:#fff9f3}
    .au-pad{padding-left:22px !important;padding-right:22px !important}
    .grid-2,.grid-hero{grid-template-columns:1fr !important}
    .grid-4{grid-template-columns:1fr 1fr !important;gap:20px !important}
    .footer-grid{grid-template-columns:1fr 1fr !important;gap:28px !important;padding:44px 22px !important}
    .flash{padding-left:22px !important;padding-right:22px !important}
    /* admin: sidebar hidden, mobile top bar + dropdown menu shown instead */
    .admin-shell{flex-direction:column !important}
    .admin-side{display:none !important}
    .admin-topbar{display:flex !important}
    .admin-main{padding:22px 16px !important}
    .prow{flex-wrap:wrap}
    .prow form{width:100%;justify-content:flex-start}
    .adm-stats{grid-template-columns:1fr 1fr !important}
    .adm-links{grid-template-columns:1fr !important}
    /* iOS Safari zooms the page when a focused field has text under 16px */
    input:not([type=checkbox]):not([type=radio]):not([type=hidden]):not([type=file]):not([type=range]),select,textarea{font-size:16px !important}
  }
  @media(max-width:520px){
    /* Stay 2-column rather than fully stacking — brand spans the full row
       (it's the widest block), Shop/Company/Support pair up beneath it,
       instead of one long single column with empty space on the right. */
    .footer-grid{grid-template-columns:1fr 1fr !important}
    .footer-brand{grid-column:1/-1}
    .btn-primary{padding:15px 26px}
    .co-row{grid-template-columns:1fr !important}
    .adm-stats{grid-template-columns:1fr !important}
  }
  /* Scroll-reveal: fade + rise into place the first time a section enters the
     viewport (see app.js). Respects reduced-motion preferences. */
  .au-reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}
  .au-reveal.au-in{opacity:1;transform:translateY(0)}

  @media (prefers-reduced-motion: reduce){
    .au-reveal{opacity:1;transform:none;transition:none}
    .prod-strip{overflow-x:auto;-webkit-mask-image:none;mask-image:none}
    .prod-strip-track{animation:none !important}
    .prod-strip-set[aria-hidden]{display:none}
    *{scroll-behavior:auto !important;animation-duration:.001ms !important;transition-duration:.001ms !important}
  }
  /* The page-load overlay now lives in /css/motion.css (first-visit curtain). */
</style>
<noscript><style>.au-reveal{opacity:1 !important;transform:none !important}</style></noscript>
<% if (_motion) { %>
<!-- Motion system (storefront only). The flags below are set before first
     paint so hidden "pre-reveal" states never flash:
       au-motion  motion allowed (not prefers-reduced-motion) — enables the hidden start states in motion.css
       au-intro   first home visit this session — shows the curtain loader
       au-fail    JS didn't come up within 4s — everything is forced visible -->
<script>
(function () {
  var d = document.documentElement;
  try {
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      d.classList.add('au-motion');
      if (location.pathname === '/' && !sessionStorage.getItem('au-intro')) d.classList.add('au-intro');
    }
  } catch (e) {}
  setTimeout(function () { if (!window.__auReady) d.classList.add('au-fail'); }, 4000);
})();
</script>
<link rel="stylesheet" href="/css/motion.css?v=<%= _av %>">
<script defer src="/js/vendor/gsap.min.js?v=<%= _av %>"></script>
<script defer src="/js/vendor/ScrollTrigger.min.js?v=<%= _av %>"></script>
<script defer src="/js/vendor/SplitText.min.js?v=<%= _av %>"></script>
<script defer src="/js/vendor/lenis.min.js?v=<%= _av %>"></script>
<script defer src="/js/motion.js?v=<%= _av %>"></script>
<!-- Hover-prefetch same-origin pages so navigation feels instant (the server takes ~1s per page).
     Excluded: anything stateful or private — bag, checkout, auth, account, wishlist, orders, admin, API. -->
<script type="speculationrules">
{"prefetch":[{"where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":["/cart*","/checkout*","/admin*","/logout*","/account*","/wishlist*","/login*","/signup*","/forgot-password*","/reset-password*","/order/*","/api/*","/_vercel/*"]}}]},"eagerness":"moderate"}]}
</script>
<% } %>
<script>
  window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
</script>
<script defer data-sdk-name="@vercel/speed-insights" data-sdk-version="2.0.0" src="/_vercel/speed-insights/script.js"></script>
