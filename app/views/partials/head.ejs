<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : 'Auréalis' %></title>
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
<link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box}
  body{margin:0;font-family:'Manrope',sans-serif;color:#3a352e}
  a.au-link{text-decoration:none;transition:opacity .15s ease}
  a.au-link:hover{opacity:.7}
  .serif{font-family:'Cormorant Garamond',serif}
  button{font-family:inherit}
  input,select,textarea{font-family:'Manrope',sans-serif}
  .btn-primary{display:inline-block;text-align:center;background:#f8ae7f;color:#3a2317;padding:16px 34px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;border-radius:100px;border:none;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease,opacity .15s ease}
  .btn-primary:hover{opacity:.92;transform:translateY(-2px);box-shadow:0 8px 20px rgba(248,174,127,.45)}
  .btn-primary:active{transform:translateY(0) scale(.98)}
  .btn-outline{display:inline-block;text-align:center;border:1px solid rgba(58,53,46,.3);padding:14px 28px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#3a352e;border-radius:100px;background:transparent;cursor:pointer;transition:background-color .15s ease,color .15s ease,transform .15s ease}
  .btn-outline:hover{background:#3a352e;color:#fff9f3;transform:translateY(-2px)}
  .btn-outline:active{transform:translateY(0) scale(.98)}
  /* Product cards: gentle lift + image zoom on hover, tactile press states.
     cubic-bezier(.22,1,.36,1) ("ease-out-expo") decelerates smoothly with no
     mechanical snap, and a longer duration reads as glide rather than jump. */
  .product-card{transition:transform .45s cubic-bezier(.22,1,.36,1)}
  .product-card:hover{transform:translateY(-6px)}
  .product-card img{transition:transform .6s cubic-bezier(.22,1,.36,1)}
  .product-card:hover img{transform:scale(1.06)}
  /* Toast (bottom-right, slides + fades in) */
  .au-toast{position:fixed;bottom:28px;right:28px;background:#3a352e;color:#fff9f3;padding:14px 20px;border-radius:12px;display:flex;align-items:center;gap:10px;font-size:14px;font-weight:600;box-shadow:0 14px 34px rgba(0,0,0,.25);z-index:200;transform:translateY(16px);opacity:0;pointer-events:none;transition:transform .25s cubic-bezier(.34,1.56,.64,1),opacity .2s ease}
  .au-toast svg{flex:none;color:#a5bf97}
  .au-toast.au-toast-show{transform:translateY(0);opacity:1}
  /* Product card interactions — quick-add icon reveals on hover with a pop-in,
     and both add buttons pulse green on a successful add so it's obvious
     something happened. */
  .product-card-quick-add{opacity:0;transform:scale(.75);transition:opacity .2s ease,transform .2s ease,background-color .15s ease}
  .product-card:hover .product-card-quick-add{opacity:1;transform:scale(1)}
  .product-card-quick-add:hover{background:#f8ae7f;transform:scale(1.1)}
  .product-card-quick-add:active{transform:scale(.92)}
  .product-card-add{transition:background-color .2s ease,color .2s ease,transform .12s ease}
  .product-card-add:hover{background:#3a352e;color:#fff9f3}
  .product-card-add:active{transform:scale(.97)}
  @keyframes au-added-pulse{
    0%{transform:scale(1)}
    35%{transform:scale(1.15)}
    100%{transform:scale(1)}
  }
  .au-added{animation:au-added-pulse .4s ease;background-color:#a5bf97 !important;color:#2f4a26 !important;border-color:#a5bf97 !important}
  .field{width:100%;padding:14px 16px;border-radius:10px;border:1px solid rgba(58,53,46,.25);font-size:14px;background:#fff}
  .field:focus{outline:none;border-color:#c1602f}
  .flash{max-width:none;padding:14px 64px;font-size:14px}
  .flash-success{background:rgba(165,191,151,.35);color:#2f4a26}
  .flash-error{background:rgba(248,174,127,.35);color:#8a3d16}
  img{max-width:100%}
  /* Hamburger menu (CSS-only) — used at all viewport widths, not just mobile */
  .nav-check{display:none}
  .nav-burger{display:flex;flex-direction:column;justify-content:center;gap:5px;width:36px;height:36px;cursor:pointer;flex:none}
  /* Hamburger → X morph: a little overshoot on the rotation (spring-like
     cubic-bezier) plus the middle bar shrinking away, not just fading, so
     the change reads as an animated transformation rather than a jump-cut. */
  .nav-burger span{display:block;height:2px;width:24px;background:#3a352e;border-radius:2px;transition:transform .4s cubic-bezier(.68,-.4,.27,1.4),opacity .25s ease}
  .nav-check:checked ~ .nav-burger span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .nav-check:checked ~ .nav-burger span:nth-child(2){opacity:0;transform:scale(0)}
  .nav-check:checked ~ .nav-burger span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .nav-mobile,.admin-nav-mobile{display:none;position:absolute;top:100%;left:0;right:0;background:#fff9f3;flex-direction:column;padding:4px 22px 14px;z-index:60;border-bottom:1px solid rgba(58,53,46,.12);box-shadow:0 12px 26px rgba(58,53,46,.14)}
  .nav-mobile a,.nav-mobile-logout,.admin-nav-mobile a{display:block;width:100%;text-align:left;padding:14px 2px;font-size:15px;color:#3a352e;text-decoration:none;border:none;border-bottom:1px solid rgba(58,53,46,.07);background:none;cursor:pointer;font-family:inherit;letter-spacing:.02em}
  .nav-mobile a:last-of-type,.admin-nav-mobile a:last-of-type{border-bottom:none}
  .admin-nav-mobile{background:#3a352e;box-shadow:0 12px 26px rgba(0,0,0,.25)}
  .admin-nav-mobile a{color:rgba(244,241,234,.85);border-bottom-color:rgba(244,241,234,.1)}
  .admin-burger span{background:#f4f1ea}
  @keyframes au-drop-in{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
  .nav-check:checked ~ .nav-mobile,.nav-check:checked ~ .admin-nav-mobile{display:flex !important;animation:au-drop-in .2s ease}
  /* Account dropdown (right side, both viewports) */
  .account-dropdown{display:none;position:absolute;top:100%;right:0;margin-top:10px;background:#fff9f3;flex-direction:column;min-width:190px;padding:6px 0;z-index:60;border-radius:12px;border:1px solid rgba(58,53,46,.12);box-shadow:0 12px 26px rgba(58,53,46,.14)}
  .account-dropdown a,.account-dropdown-logout{display:block;width:100%;text-align:left;padding:11px 18px;font-size:14px;color:#3a352e;text-decoration:none;border:none;background:none;cursor:pointer;font-family:inherit}
  .account-dropdown a:hover,.account-dropdown-logout:hover{background:rgba(58,53,46,.06)}
  .nav-check:checked ~ .account-dropdown{display:flex;animation:au-drop-in .2s ease}
  @media(max-width:820px){
    .au-header{padding:14px 22px !important;flex-wrap:wrap;gap:10px 18px}
    .au-pad{padding-left:22px !important;padding-right:22px !important}
    .grid-2,.grid-hero{grid-template-columns:1fr !important}
    .grid-4{grid-template-columns:1fr 1fr !important;gap:20px !important}
    .footer-grid{grid-template-columns:1fr 1fr !important;gap:28px !important;padding:44px 22px !important}
    .flash{padding-left:22px !important;padding-right:22px !important}
    /* admin: sidebar hidden, mobile top bar + dropdown menu shown instead */
    .admin-shell{flex-direction:column !important}
    .admin-side{display:none !important}
    .admin-topbar{display:flex !important}
    .admin-main{padding:22px 16px !important}
    .prow{flex-wrap:wrap}
    .prow form{width:100%;justify-content:flex-start}
  }
  @media(max-width:520px){
    .footer-grid{grid-template-columns:1fr !important}
    .btn-primary{padding:15px 26px}
  }
  /* Scroll-reveal: fade + rise into place the first time a section enters the
     viewport (see app.js). Respects reduced-motion preferences. */
  .au-reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}
  .au-reveal.au-in{opacity:1;transform:translateY(0)}
  @media (prefers-reduced-motion: reduce){
    .au-reveal{opacity:1;transform:none;transition:none}
    *{scroll-behavior:auto !important;animation-duration:.001ms !important;transition-duration:.001ms !important}
  }
  /* Page-load spinner: the favicon mark, spinning, over a full-screen cream
     backdrop — removed once the page (incl. images) has fully loaded. */
  @keyframes au-spin{to{transform:rotate(360deg)}}
  .au-loader{position:fixed;inset:0;background:#fff9f3;z-index:300;display:flex;align-items:center;justify-content:center;transition:opacity .35s ease}
  .au-loader img{width:56px;height:56px;animation:au-spin 1s linear infinite}
  .au-loader-hide{opacity:0;pointer-events:none}
</style>
<script>
  window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
</script>
<script defer data-sdk-name="@vercel/speed-insights" data-sdk-version="2.0.0" src="/_vercel/speed-insights/script.js"></script>
