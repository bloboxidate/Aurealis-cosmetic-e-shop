<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : 'Auréalis' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box}
  body{margin:0;font-family:'Manrope',sans-serif;color:#3a352e}
  a.au-link{text-decoration:none}
  a.au-link:hover{opacity:.7}
  .serif{font-family:'Cormorant Garamond',serif}
  button{font-family:inherit}
  input,select,textarea{font-family:'Manrope',sans-serif}
  .btn-primary{display:inline-block;text-align:center;background:#f8ae7f;color:#3a2317;padding:16px 34px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;border-radius:100px;border:none;cursor:pointer}
  .btn-primary:hover{opacity:.9}
  .btn-outline{display:inline-block;text-align:center;border:1px solid rgba(58,53,46,.3);padding:14px 28px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#3a352e;border-radius:100px;background:transparent;cursor:pointer}
  .field{width:100%;padding:14px 16px;border-radius:10px;border:1px solid rgba(58,53,46,.25);font-size:14px;background:#fff}
  .field:focus{outline:none;border-color:#c1602f}
  .flash{max-width:none;padding:14px 64px;font-size:14px}
  .flash-success{background:rgba(165,191,151,.35);color:#2f4a26}
  .flash-error{background:rgba(248,174,127,.35);color:#8a3d16}
  img{max-width:100%}
  /* Mobile hamburger menu (CSS-only) */
  .nav-check{display:none}
  .nav-burger{display:none;flex-direction:column;justify-content:center;gap:5px;width:36px;height:36px;cursor:pointer;flex:none}
  .nav-burger span{display:block;height:2px;width:24px;background:#3a352e;border-radius:2px;transition:transform .25s,opacity .2s}
  .nav-check:checked ~ .nav-burger span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .nav-check:checked ~ .nav-burger span:nth-child(2){opacity:0}
  .nav-check:checked ~ .nav-burger span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .nav-mobile{display:none;position:absolute;top:100%;left:0;right:0;background:#fff9f3;flex-direction:column;padding:4px 22px 14px;z-index:60;border-bottom:1px solid rgba(58,53,46,.12);box-shadow:0 12px 26px rgba(58,53,46,.14)}
  .nav-mobile a,.nav-mobile-logout{display:block;width:100%;text-align:left;padding:14px 2px;font-size:15px;color:#3a352e;text-decoration:none;border:none;border-bottom:1px solid rgba(58,53,46,.07);background:none;cursor:pointer;font-family:inherit;letter-spacing:.02em}
  .nav-mobile a:last-of-type{border-bottom:none}
  @media(max-width:820px){
    .nav-desktop{display:none !important}
    .nav-burger{display:flex !important}
    .nav-check:checked ~ .nav-mobile{display:flex !important}
    .au-header{padding:14px 22px !important;flex-wrap:wrap;gap:10px 18px}
    .au-nav{gap:18px !important}
    .au-pad{padding-left:22px !important;padding-right:22px !important}
    .grid-2,.grid-hero{grid-template-columns:1fr !important}
    .grid-4{grid-template-columns:1fr 1fr !important;gap:20px !important}
    .footer-grid{grid-template-columns:1fr 1fr !important;gap:28px !important;padding:44px 22px !important}
    .flash{padding-left:22px !important;padding-right:22px !important}
    /* admin: sidebar becomes a horizontal top bar, content below */
    .admin-shell{flex-direction:column !important}
    .admin-side{width:100% !important;min-height:0 !important;display:flex;align-items:center;overflow-x:auto;padding:8px 10px !important;gap:2px}
    .admin-side .admin-brand{padding:6px 12px 6px 6px !important;flex:none}
    .admin-side .admin-brand .serif{font-size:16px !important}
    .admin-side .admin-brand div{display:none}
    .admin-side a{display:inline-block !important;white-space:nowrap;padding:10px 14px !important;border-left:none !important;border-radius:8px}
    .admin-main{padding:22px 16px !important}
    .prow{flex-wrap:wrap}
    .prow form{width:100%;justify-content:flex-start}
  }
  @media(max-width:520px){
    .footer-grid{grid-template-columns:1fr !important}
    .btn-primary{padding:15px 26px}
  }
</style>
