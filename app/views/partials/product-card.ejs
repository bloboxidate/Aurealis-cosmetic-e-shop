<%
  // locals: p (product), and optional h (image height px), showSub (bool)
  const h = typeof cardH !== 'undefined' ? cardH : 270;
  const showSub = typeof cardShowSub !== 'undefined' ? cardShowSub : false;
%>
<div class="product-card">
  <a href="/product/<%= p.slug %>" style="text-decoration:none;color:inherit;display:block">
    <div style="position:relative;width:100%;height:<%= h %>px;margin-bottom:14px;border-radius:16px;overflow:hidden;background:<%= p.color || '#f1ece5' %>;display:flex;align-items:center;justify-content:center">
      <% if (p.image_url) { %>
        <img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy" style="width:100%;height:100%;object-fit:contain;display:block">
      <% } else { %>
        <span style="font-size:13px;color:#b3a996;letter-spacing:.05em"><%= p.name %></span>
      <% } %>
      <button type="button" class="product-card-quick-add" data-product-id="<%= p.id %>" aria-label="Add to bag" title="Add to bag" style="position:absolute;top:12px;right:12px;width:40px;height:40px;padding:0;border-radius:50%;background:#fff9f3;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 12px rgba(58,53,46,.22);z-index:2">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3a352e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
      </button>
    </div>
    <div style="font-size:15px;font-weight:700;margin-bottom:4px"><%= p.name %></div>
    <% if (showSub && p.subtitle) { %><div style="font-size:13px;color:#6b6357;margin-bottom:4px"><%= p.subtitle %></div><% } %>
    <div style="font-size:14px;color:#8a8175;margin-bottom:10px"><%= price(p.price_cents) %></div>
  </a>
  <button type="button" class="product-card-add" data-product-id="<%= p.id %>" style="width:100%;padding:11px;border-radius:100px;border:1px solid rgba(58,53,46,.3);background:none;font-size:12px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;font-weight:700;color:#3a352e">Add to Bag</button>
</div>
