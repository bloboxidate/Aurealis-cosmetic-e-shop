<%
  // locals: p (product), and optional h (image height px), showSub (bool)
  const h = typeof cardH !== 'undefined' ? cardH : 270;
  const showSub = typeof cardShowSub !== 'undefined' ? cardShowSub : false;
%>
<a href="/product/<%= p.slug %>" style="text-decoration:none;color:inherit;display:block">
  <div style="width:100%;height:<%= h %>px;margin-bottom:14px;border-radius:16px;overflow:hidden;background:<%= p.color || '#f1ece5' %>;display:flex;align-items:center;justify-content:center">
    <% if (p.image_url) { %>
      <img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
    <% } else { %>
      <span style="font-size:13px;color:#b3a996;letter-spacing:.05em"><%= p.name %></span>
    <% } %>
  </div>
  <div style="font-size:15px;font-weight:700;margin-bottom:4px"><%= p.name %></div>
  <% if (showSub && p.subtitle) { %><div style="font-size:13px;color:#6b6357;margin-bottom:4px"><%= p.subtitle %></div><% } %>
  <div style="font-size:14px;color:#8a8175"><%= price(p.price_cents) %></div>
</a>
