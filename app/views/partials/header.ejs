<% const active = typeof navActive !== 'undefined' ? navActive : ''; %>
<% const cats = (typeof navCategories !== 'undefined' ? navCategories : []); %>
<div class="au-header" style="position:relative;display:flex;align-items:center;justify-content:space-between;padding:16px 64px;border-bottom:1px solid rgba(58,53,46,.12)">
  <a href="/" style="display:flex;align-items:center"><img src="/assets/aurealis-logo-black.webp" alt="Auréalis" style="height:clamp(56px,11vw,110px);width:auto;display:block"></a>

  <!-- Desktop nav -->
  <div class="nav-desktop" style="display:flex;align-items:center;gap:40px">
    <div class="au-nav" style="display:flex;gap:36px;font-size:13px;letter-spacing:.04em;text-transform:uppercase">
      <% cats.forEach(function(c){ %><a class="au-link" href="/shop?category=<%= c.slug %>" style="color:#3a352e;<%= active===c.slug?'font-weight:700':'' %>"><%= c.name %></a><% }); %>
      <a class="au-link" href="/about" style="color:#3a352e;<%= active==='about'?'font-weight:700':'' %>">About</a>
      <a class="au-link" href="/shop" style="color:#3a352e;<%= active==='shop'?'font-weight:700':'' %>">Shop All</a>
    </div>
    <div style="display:flex;gap:22px;font-size:13px;letter-spacing:.03em;align-items:center">
      <% if (user) { %>
        <a class="au-link" href="/account" style="color:#3a352e"><%= user.first_name || 'Account' %></a>
        <% if (user.is_admin) { %><a class="au-link" href="/admin" style="color:#c1602f;font-weight:700">Admin</a><% } %>
        <form action="/logout" method="post" style="margin:0"><button type="submit" style="background:none;border:none;cursor:pointer;font-size:13px;color:#3a352e;padding:0;letter-spacing:.03em">Logout</button></form>
      <% } else { %>
        <a class="au-link" href="/login" style="color:#3a352e">Login</a>
      <% } %>
      <a class="au-link" href="/cart" style="color:#3a352e<%= active==='cart'?';font-weight:700':'' %>">Bag (<%= cartCount %>)</a>
    </div>
  </div>

  <!-- Mobile hamburger (CSS-only toggle) -->
  <input type="checkbox" id="nav-toggle" class="nav-check">
  <label for="nav-toggle" class="nav-burger" aria-label="Menu">
    <span></span><span></span><span></span>
  </label>
  <div class="nav-mobile">
    <% cats.forEach(function(c){ %><a class="au-link" href="/shop?category=<%= c.slug %>"><%= c.name %></a><% }); %>
    <a class="au-link" href="/shop">Shop All</a>
    <a class="au-link" href="/about">About</a>
    <a class="au-link" href="/cart">Bag (<%= cartCount %>)</a>
    <% if (user) { %>
      <a class="au-link" href="/account"><%= user.first_name || 'My Account' %></a>
      <% if (user.is_admin) { %><a class="au-link" href="/admin" style="color:#c1602f;font-weight:700">Admin</a><% } %>
      <form action="/logout" method="post" style="margin:0"><button type="submit" class="nav-mobile-logout">Logout</button></form>
    <% } else { %>
      <a class="au-link" href="/login">Login</a>
    <% } %>
  </div>
</div>
<%- include('flash') %>
