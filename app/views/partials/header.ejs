<% const active = typeof navActive !== 'undefined' ? navActive : ''; %>
<% const cats = (typeof navCategories !== 'undefined' ? navCategories : []); %>
<!-- First-visit curtain (home only, once per session). Hidden by default; head.ejs
     adds html.au-intro to show it and motion.js lifts it. It no longer waits for
     window.load — it never blocks on images, and is forced away if JS fails. -->
<div id="au-loader" class="au-loader" aria-hidden="true"><div class="au-loader-panel"></div><img src="/assets/aurealis-logo-black.webp" alt=""><span class="au-loader-line"></span></div>
<div class="au-header" role="banner" style="position:relative;display:flex;align-items:center;justify-content:space-between;padding:16px 64px;border-bottom:1px solid rgba(58,53,46,.12)">

  <!-- Left: hamburger nav (all viewports) -->
  <div style="display:flex;align-items:center;z-index:2">
    <input type="checkbox" id="nav-toggle" class="nav-check" aria-label="Menu">
    <label for="nav-toggle" class="nav-burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>
    <div class="nav-mobile" role="navigation" aria-label="Primary">
      <% cats.forEach(function(c){ %><a class="au-link" href="/shop?category=<%= c.slug %>" style="<%= active===c.slug?'font-weight:700':'' %>"><%= c.name %></a><% }); %>
      <a class="au-link" href="/shop" style="<%= active==='shop'?'font-weight:700':'' %>">Shop All</a>
      <a class="au-link" href="/about" style="<%= active==='about'?'font-weight:700':'' %>">About</a>
    </div>
  </div>

  <!-- Center: logo -->
  <a class="au-logo" href="/" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center">
    <img src="/assets/aurealis-logo-black.webp" alt="Auréalis" style="height:clamp(84px,15.75vw,140px);width:auto;display:block">
  </a>

  <!-- Right: cart + account -->
  <div style="display:flex;align-items:center;gap:20px;z-index:2">
    <a class="au-link" href="/cart" aria-label="Bag" style="color:#3a352e;position:relative;display:flex;align-items:center">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
      <span id="cart-badge" style="position:absolute;top:-8px;right:-9px;background:#c1602f;color:#fff9f3;font-size:10px;font-weight:700;min-width:16px;height:16px;border-radius:100px;display:<%= cartCount > 0 ? 'flex' : 'none' %>;align-items:center;justify-content:center;padding:0 3px"><%= cartCount %></span>
    </a>

    <% if (user) { %>
      <div class="account-menu" style="position:relative;display:flex;align-items:center">
        <input type="checkbox" id="account-toggle" class="nav-check" aria-label="Account menu">
        <label for="account-toggle" aria-label="Account" style="color:#3a352e;cursor:pointer;display:flex;align-items:center">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-7 8-7s8 3 8 7"/></svg>
        </label>
        <div class="account-dropdown">
          <div style="padding:14px 18px 10px;font-weight:700;font-size:14px;border-bottom:1px solid rgba(58,53,46,.08)"><%= user.first_name || 'Account' %></div>
          <a class="au-link" href="/account">Order History</a>
          <a class="au-link" href="/wishlist">Wishlist</a>
          <% if (user.is_admin) { %><a class="au-link" href="/admin" style="color:#c1602f;font-weight:700">Admin</a><% } %>
          <form action="/logout" method="post" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="account-dropdown-logout">Logout</button></form>
        </div>
      </div>
    <% } else { %>
      <div class="account-menu" style="position:relative;display:flex;align-items:center">
        <input type="checkbox" id="account-toggle" class="nav-check" aria-label="Account menu">
        <label for="account-toggle" aria-label="Account" style="color:#3a352e;cursor:pointer;display:flex;align-items:center">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-7 8-7s8 3 8 7"/></svg>
        </label>
        <div class="account-dropdown">
          <a class="au-link" href="/login">Login</a>
          <a class="au-link" href="/signup">Create account</a>
        </div>
      </div>
    <% } %>
  </div>
</div>
<%- include('flash') %>
<!-- Toast for JS-driven confirmations (e.g. add-to-cart) — hidden by default -->
<div id="au-toast" class="au-toast" role="status" aria-live="polite">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
  <span class="au-toast-text"></span>
</div>
