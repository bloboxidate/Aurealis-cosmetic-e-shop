<div class="au-pad footer-grid" style="padding:56px 64px;background:linear-gradient(100deg,#3f6f86,#4c6b45,#5f4f96);color:#f4f1ea;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px">
  <div class="footer-brand">
    <img src="/assets/aurealis-logo-black.webp" alt="Auréalis" style="width:200px;height:52px;max-width:100%;object-fit:cover;object-position:center;display:block;margin-bottom:16px;filter:brightness(0) invert(1)">
    <% var _f = (typeof footer !== 'undefined' && footer) ? footer : {}; %>
    <div style="font-size:13px;line-height:1.6;max-width:260px;color:rgba(244,241,234,.85)"><%= _f.tagline || 'Beauty inspired by the northern lights — radiant, ever-shifting glow.' %></div>
    <% if (_f.email || _f.phone || _f.instagram || _f.tiktok) { %>
      <div style="font-size:12px;line-height:2;color:rgba(244,241,234,.8);margin-top:14px">
        <% if (_f.email) { %><a class="au-link" href="mailto:<%= _f.email %>" style="display:block;color:inherit"><%= _f.email %></a><% } %>
        <% if (_f.phone) { %><span style="display:block"><%= _f.phone %></span><% } %>
        <% if (_f.instagram || _f.tiktok) { %>
          <div style="display:flex;align-items:center;gap:16px;margin-top:6px">
            <% if (_f.instagram) { %><a class="au-link" href="<%= _f.instagram %>" aria-label="Instagram" target="_blank" rel="noopener" style="display:inline-flex;color:inherit"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none"/></svg></a><% } %>
            <% if (_f.tiktok) { %><a class="au-link" href="<%= _f.tiktok %>" aria-label="TikTok" target="_blank" rel="noopener" style="display:inline-flex;color:inherit"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 3c.3 2.1 1.5 3.6 3.5 3.9v2.4c-1.2.1-2.3-.2-3.4-.8v5.9c0 3.2-2.4 5.6-5.5 5.6-3 0-5.3-2.3-5.3-5.2 0-3 2.4-5.3 5.6-5v2.5c-.3-.1-.7-.1-1-.1-1.4 0-2.5 1.1-2.5 2.6 0 1.5 1.1 2.6 2.6 2.6 1.5 0 2.6-1.1 2.6-2.7V3h2.9z"/></svg></a><% } %>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
  <div style="font-size:13px;line-height:2.2;color:rgba(244,241,234,.85)">
    <div style="color:#fff;margin-bottom:8px;font-size:12px;letter-spacing:.08em;text-transform:uppercase">Shop</div>
    <% (typeof navCategories !== 'undefined' ? navCategories : []).forEach(function(c){ %>
      <a class="au-link" href="/shop?category=<%= c.slug %>" style="display:block;color:inherit"><%= c.name %></a>
    <% }); %>
    <a class="au-link" href="/shop" style="display:block;color:inherit">Shop All</a>
  </div>
  <div style="font-size:13px;line-height:2.2;color:rgba(244,241,234,.85)">
    <div style="color:#fff;margin-bottom:8px;font-size:12px;letter-spacing:.08em;text-transform:uppercase">Company</div>
    <a class="au-link" href="/about" style="display:block;color:inherit">About</a>
    <span style="display:block">Journal</span>
    <a class="au-link" href="/contact" style="display:block;color:inherit">Contact Us</a>
  </div>
  <div style="font-size:13px;line-height:2.2;color:rgba(244,241,234,.85)">
    <div style="color:#fff;margin-bottom:8px;font-size:12px;letter-spacing:.08em;text-transform:uppercase">Support</div>
    <a class="au-link" href="/shipping-policy" style="display:block;color:inherit">Shipping Policy</a>
    <a class="au-link" href="/refund-policy" style="display:block;color:inherit">Refund Policy</a>
    <div>FAQ</div>
  </div>
</div>
