<%
  // Shared admin shell (open). Locals: title, adminActive, adminBadges ({reviews}), csrfToken, user.
  // A page includes this, writes its own .adm-head + content, then includes admin-close.
  const a = typeof adminActive !== 'undefined' ? adminActive : '';
  const badges = typeof adminBadges !== 'undefined' && adminBadges ? adminBadges : {};
  const I = {
    home: '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>',
    bag: '<path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/>',
    tag: '<path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="7.5" cy="8.5" r="1.2"/>',
    layout: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/>',
    file: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 13h6M9 17h6"/>',
    sliders: '<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>',
    star: '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>',
    ext: '<path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6"/>',
    out: '<path d="M9 4H5v16h4M16 8l4 4-4 4M20 12H9"/>',
    search: '<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>',
    menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  };
  const nav = [
    ['dashboard', 'Dashboard', '/admin', 'home'],
    ['products', 'Products', '/admin/products', 'bag'],
    ['categories', 'Categories', '/admin/categories', 'tag'],
    ['homepage', 'Homepage', '/admin/homepage', 'layout'],
    ['pages', 'Pages', '/admin/pages', 'file'],
    ['settings', 'Site settings', '/admin/settings', 'sliders'],
    ['reviews', 'Reviews', '/admin/reviews', 'star'],
  ];
  const current = nav.find(function (n) { return n[0] === a; });
%><!doctype html>
<html lang="en">
<head>
<%- include('head') %>
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="/css/admin.css?v=<%= typeof assetV !== 'undefined' ? assetV : '1' %>">
</head>
<body>
<div class="adm" id="adm">
  <aside class="adm-side" id="adm-side" aria-label="Admin navigation">
    <a class="adm-brand" href="/admin" aria-label="Auréalis admin home">
      <img src="/assets/aurealis-logo-black.webp" alt="Auréalis">
      <small>Studio</small>
    </a>
    <nav class="adm-nav">
      <% nav.forEach(function (n) { %>
        <a href="<%= n[2] %>" class="<%= a === n[0] ? 'is-active' : '' %>"<%- a === n[0] ? ' aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><%- I[n[3]] %></svg><%= n[1] %>
          <% if (n[0] === 'reviews' && badges.reviews > 0) { %><span class="count" aria-label="<%= badges.reviews %> pending"><%= badges.reviews %></span><% } %>
        </a>
      <% }); %>
    </nav>
    <div class="adm-side-foot">
      <a href="/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><%- I.ext %></svg>View store</a>
      <form action="/logout" method="post" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><%- I.out %></svg>Sign out</button></form>
      <div class="adm-who"><%= user && (user.first_name || user.email) %></div>
    </div>
  </aside>
  <div class="adm-scrim" data-nav-close></div>

  <div class="adm-main">
    <header class="adm-top">
      <button type="button" class="adm-burger" id="adm-burger" aria-label="Open menu" aria-controls="adm-side"><svg viewBox="0 0 24 24" aria-hidden="true"><%- I.menu %></svg></button>
      <div class="adm-crumb"><%= current ? current[1] : 'Admin' %></div>
      <div class="adm-top-actions">
        <button type="button" class="adm-search" id="adm-search" aria-label="Search and jump to…"><svg viewBox="0 0 24 24" aria-hidden="true"><%- I.search %></svg><span>Jump to…</span><kbd>Ctrl K</kbd></button>
        <a class="btn btn-sm" href="/" target="_blank" rel="noopener" aria-label="View store"><svg viewBox="0 0 24 24" aria-hidden="true"><%- I.ext %></svg><span class="hide-sm">View store</span></a>
      </div>
    </header>
    <main class="adm-content" id="main">
