<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div style="background-color:#fff9f3;min-height:100vh;background-repeat:repeat-y;background-size:100% 950px;background-image:
    radial-gradient(700px circle at 10% 8%, rgba(165,209,228,.5), transparent 60%),
    radial-gradient(650px circle at 90% 20%, rgba(191,181,232,.45), transparent 58%),
    radial-gradient(750px circle at 40% 70%, rgba(165,191,151,.4), transparent 60%)">

  <%- include('partials/header', { navActive: '' }) %>

  <div class="au-pad" style="padding:56px 64px 100px;max-width:900px">
    <div role="heading" aria-level="1" class="serif" style="font-size:clamp(28px,6.5vw,42px);margin-bottom:6px">Hello, <%= user.first_name || 'there' %></div>
    <div style="font-size:14px;color:#6b6357;margin-bottom:40px"><%= user.email %></div>

    <div style="font-size:20px;font-weight:700;margin-bottom:20px">Order History</div>
    <% if (typeof ordersError !== 'undefined' && ordersError && orders.length === 0) { %>
      <div style="background:rgba(255,255,255,.6);border-radius:16px;padding:36px;text-align:center;color:#6b6357">
        We're having trouble loading your orders right now. <a class="au-link" href="/account" style="color:#c1602f;font-weight:700">Try again</a>
      </div>
    <% } else if (orders.length === 0) { %>
      <div style="background:rgba(255,255,255,.6);border-radius:16px;padding:36px;text-align:center;color:#6b6357">
        You haven’t placed any orders yet. <a class="au-link" href="/shop" style="color:#c1602f;font-weight:700">Start shopping →</a>
      </div>
    <% } else { %>
      <% if (typeof ordersError !== 'undefined' && ordersError) { %>
        <div style="font-size:13px;color:#c1602f;margin-bottom:16px">Some orders couldn't be loaded right now — check back shortly.</div>
      <% } %>
      <% orders.forEach(function(o){ %>
        <div style="background:rgba(255,255,255,.6);border-radius:16px;padding:24px 28px;margin-bottom:16px">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:14px">
            <div>
              <div style="font-weight:700">Order <%= o.number %></div>
              <div style="font-size:13px;color:#6b6357"><%= o.date %><% if (o.status) { %> · <span style="text-transform:capitalize"><%= o.status %></span><% } %><% if (o.payment) { %> · <span style="text-transform:capitalize"><%= o.payment %></span><% } %></div>
            </div>
            <div style="font-size:18px;font-weight:700"><%= money(o.total_cents) %></div>
          </div>
          <% o.items.forEach(function(it){ %>
            <div style="display:flex;align-items:center;gap:12px;padding:6px 0">
              <div style="width:40px;height:40px;border-radius:8px;background:#f1ece5;flex:none;overflow:hidden"><% if (it.image_url) { %><img src="<%= it.image_url %>" style="width:100%;height:100%;object-fit:cover"><% } %></div>
              <span style="flex:1;font-size:13px;color:#5a5148"><%= it.name %> × <%= it.qty %></span>
              <span style="font-size:13px;color:#5a5148"><%= money(it.line_cents) %></span>
            </div>
          <% }); %>
          <form action="/account/orders/<%= o.id %>/cancel-request" method="post" style="margin-top:14px;padding-top:14px;border-top:1px solid rgba(58,53,46,.1)">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="au-link" style="background:none;border:none;cursor:pointer;font-size:13px;color:#8a8175;padding:0">Request cancellation</button>
          </form>
        </div>
      <% }); %>
    <% } %>
  </div>

  <%- include('partials/footer') %>
</div>
</body>
</html>
