<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div style="background-color:#fff9f3;background-repeat:repeat-y;background-size:100% 950px;background-image:
    radial-gradient(700px circle at 8% 8%, rgba(165,209,228,.7), transparent 60%),
    radial-gradient(650px circle at 92% 20%, rgba(191,181,232,.65), transparent 58%),
    radial-gradient(750px circle at 30% 55%, rgba(165,191,151,.65), transparent 60%),
    radial-gradient(700px circle at 88% 62%, rgba(247,213,149,.7), transparent 58%),
    radial-gradient(750px circle at 15% 92%, rgba(248,174,127,.65), transparent 58%),
    radial-gradient(650px circle at 75% 98%, rgba(165,209,228,.55), transparent 55%)">

  <%- include('partials/header', { navActive: '' }) %>

  <!-- hero -->
  <div class="au-pad" style="position:relative;padding:80px 64px 0;overflow:hidden">
    <div class="grid-hero au-reveal" style="display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:60px;position:relative;z-index:1">
      <div>
        <div style="font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:#c1602f;font-weight:700;margin-bottom:18px"><%= home.hero_eyebrow %></div>
        <div class="serif" style="font-weight:500;font-size:clamp(42px,10vw,74px);line-height:1.05;margin-bottom:26px"><%= home.hero_title %></div>
        <div style="font-size:clamp(15px,4vw,17px);line-height:1.6;color:#565149;max-width:420px;margin-bottom:36px"><%= home.hero_text %></div>
        <a class="au-link btn-primary" href="/shop"><%= home.hero_cta %></a>
      </div>
      <div style="position:relative;width:100%;height:clamp(240px,55vw,500px);border-radius:20px;overflow:hidden;background:
          radial-gradient(120% 120% at 20% 10%, rgba(165,209,228,.95), transparent 55%),
          radial-gradient(120% 120% at 90% 30%, rgba(191,181,232,.9), transparent 55%),
          radial-gradient(140% 120% at 50% 90%, rgba(165,191,151,.9), transparent 55%),
          linear-gradient(160deg,#2c3e50,#34495e)">
        <% if (home.hero_image) { %><img src="<%= home.hero_image %>" alt="" style="width:100%;height:100%;object-fit:cover;display:block"><% } %>
      </div>
    </div>
  </div>

  <!-- category strip (dynamic from your storefront categories) -->
  <% var _cats = (typeof navCategories !== 'undefined' ? navCategories : []); %>
  <% if (_cats.length) { %>
    <% var _grads = ['#a5bf97','#f7d595','#a5d1e4','#bfb5e8','#f8ae7f']; %>
    <div class="au-pad au-reveal cat-strip" style="display:grid;grid-template-columns:repeat(<%= Math.min(_cats.length, 3) %>,1fr);gap:20px;padding:70px 64px 0">
      <% _cats.slice(0,6).forEach(function(c, i){ %>
        <a href="/shop?category=<%= c.slug %>" class="cat-tile" style="position:relative;height:clamp(200px,45vw,340px);border-radius:20px;overflow:hidden;<%= c.image_url ? '' : 'background:'+_grads[i % _grads.length]+';' %>display:block">
          <% if (c.image_url) { %><img src="<%= c.image_url %>" alt="" style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0"><% } %>
          <div class="cat-chip-wrap" style="position:absolute;left:50%;bottom:20px;transform:translateX(-50%);background:rgba(255,249,243,.9);padding:8px 18px;border-radius:20px;max-width:calc(100% - 24px);box-sizing:border-box">
            <div class="cat-chip" style="font-size:15px;font-weight:700;color:#3a352e;text-align:center;white-space:normal;overflow-wrap:break-word"><%= c.name %></div>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>

  <!-- bestsellers -->
  <% if (bestsellers.length) { %>
  <div class="au-pad au-reveal" style="padding:clamp(48px,9vw,80px) 64px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:40px">
      <div class="serif" style="font-size:clamp(28px,6vw,36px)">Bestsellers</div>
      <a class="au-link" href="/shop" style="font-size:13px;letter-spacing:.05em;color:#c1602f;text-transform:uppercase;font-weight:700">View all</a>
    </div>
    <div class="grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:28px">
      <% bestsellers.forEach(function(p){ %>
        <%- include('partials/product-card', { p, cardH: 270 }) %>
      <% }); %>
    </div>
  </div>
  <% } %>

  <!-- brand story -->
  <div style="height:8px;background:linear-gradient(90deg,#f7d595 0%,#a5d1e4 33%,#a5bf97 66%,#bfb5e8 100%)"></div>
  <div class="au-pad grid-2 au-reveal" style="display:grid;grid-template-columns:1fr 1fr;align-items:center;background:rgba(255,255,255,.4);backdrop-filter:blur(2px);padding:80px 64px;gap:60px">
    <div style="width:100%;height:clamp(220px,50vw,420px);border-radius:20px;overflow:hidden;background:
        radial-gradient(120% 120% at 30% 20%, rgba(191,181,232,.9), transparent 55%),
        radial-gradient(120% 120% at 80% 80%, rgba(247,213,149,.9), transparent 55%),
        linear-gradient(160deg,#3f6f86,#4c6b45)"></div>
    <div>
      <div class="serif" style="font-size:clamp(22px,5vw,30px);line-height:1.4;margin-bottom:24px">"The aurora taught us that light is never one color. Every formula moves through sage, azure and lavender the way the sky does."</div>
      <a class="au-link" href="/about" style="font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#c1602f;font-weight:700">Our Story →</a>
    </div>
  </div>

  <%- include('partials/footer') %>
</div>
<script src="/js/app.js"></script>
</body>
</html>
