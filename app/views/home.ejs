<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div style="background-color:#fff9f3;background-repeat:repeat-y;background-size:100% 950px;background-image:
    radial-gradient(700px circle at 8% 8%, rgba(165,209,228,.7), transparent 60%),
    radial-gradient(650px circle at 92% 20%, rgba(191,181,232,.65), transparent 58%),
    radial-gradient(750px circle at 30% 55%, rgba(165,191,151,.65), transparent 60%),
    radial-gradient(700px circle at 88% 62%, rgba(247,213,149,.7), transparent 58%),
    radial-gradient(750px circle at 15% 92%, rgba(248,174,127,.65), transparent 58%),
    radial-gradient(650px circle at 75% 98%, rgba(165,209,228,.55), transparent 55%)">

  <%- include('partials/header', { navActive: '' }) %>

  <!-- hero -->
  <section class="au-hero" style="position:relative;min-height:clamp(560px,calc(100svh - 70px),900px);display:flex;align-items:center;overflow:hidden;background:
      radial-gradient(120% 120% at 20% 10%, rgba(165,209,228,.95), transparent 55%),
      radial-gradient(120% 120% at 90% 30%, rgba(191,181,232,.9), transparent 55%),
      radial-gradient(140% 120% at 50% 90%, rgba(165,191,151,.9), transparent 55%),
      linear-gradient(160deg,#2c3e50,#34495e)">
    <% if (home.hero_image) { %><img class="au-hero-img" src="<%= home.hero_image %>" alt="" fetchpriority="high" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block"><% } %>
    <!-- Atmosphere (decorative, motion-only; see motion.css/motion.js): slow drifting light in the brand palette over the photo -->
    <div class="au-hero-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <!-- scrim: darkest on the left where the text sits, fading to clear on the right -->
    <div class="au-hero-grade" style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(38,20,10,.66) 0%,rgba(46,26,14,.4) 42%,rgba(60,34,18,.08) 74%,rgba(60,34,18,0) 100%)"></div>
    <!-- golden hour: a warm bloom behind the face, in the moodboard's light -->
    <div class="au-hero-sun" aria-hidden="true"></div>
    <div class="au-hero-glow" aria-hidden="true"></div>
    <div class="au-hero-sparks" aria-hidden="true"></div>
    <div class="au-hero-veil" aria-hidden="true"></div>
    <div class="au-pad" style="position:relative;z-index:1;width:100%;padding:96px 64px">
      <div data-hero-copy style="max-width:560px">
        <div data-hero="eyebrow" style="font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:#f0b892;font-weight:700;margin-bottom:18px"><%= home.hero_eyebrow %></div>
        <div data-hero="title" role="heading" aria-level="1" class="serif" style="font-weight:500;font-size:clamp(42px,10vw,74px);line-height:1.05;margin-bottom:26px;color:#fff"><%= home.hero_title %></div>
        <div data-hero="text" style="font-size:clamp(15px,4vw,17px);line-height:1.6;color:rgba(244,241,234,.9);max-width:440px;margin-bottom:36px"><%= home.hero_text %></div>
        <a data-hero="cta" class="au-link btn-primary" href="/shop"><%= home.hero_cta %></a>
      </div>
    </div>
    <div class="au-hero-cue" aria-hidden="true"><span></span></div>
  </section>

  <!-- rotating product strip: every product, looping continuously. The track is
       rendered twice so the -50% translate loops seamlessly; the copy is
       aria-hidden. Pauses on hover/focus; with reduced motion it becomes a
       plain horizontally-scrollable row. -->
  <% var _strip = (typeof allProducts !== 'undefined' ? allProducts : []).filter(function(p){ return p.image_url; }); %>
  <% if (_strip.length) { %>
    <% var _loops = _strip.length < 6 ? Math.ceil(6 / _strip.length) : 1; %>
    <% var _dur = Math.max(30, _strip.length * _loops * 4); %>
    <div data-strip style="padding:clamp(40px,7vw,70px) 0 0">
      <div class="prod-strip" aria-label="All products">
        <div class="prod-strip-track" style="animation-duration:<%= _dur %>s">
          <% for (var _copy = 0; _copy < 2; _copy++) { %>
            <div class="prod-strip-set" <%- _copy ? 'aria-hidden="true"' : '' %>>
              <% for (var _r = 0; _r < _loops; _r++) { _strip.forEach(function(p){ %>
                <a class="prod-strip-item au-link" href="/product/<%= p.slug %>" <%- _copy ? 'tabindex="-1"' : '' %>>
                  <div class="prod-strip-img" style="background:<%= p.color || '#f1ece5' %>"><img src="<%= p.image_url %>" alt="<%= _copy ? '' : p.name %>" loading="lazy"></div>
                  <div class="prod-strip-name"><%= p.name %></div>
                  <div class="prod-strip-price"><%= price(p.price_cents) %></div>
                </a>
              <% }); } %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <!-- bestsellers -->
  <% if (bestsellers.length) { %>
  <div class="au-pad" style="padding:clamp(48px,9vw,80px) 64px">
    <div data-m="rise" style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:40px">
      <div class="serif" style="font-size:clamp(28px,6vw,36px)">Bestsellers</div>
      <a class="au-link au-ulink" href="/shop" style="font-size:13px;letter-spacing:.05em;color:#c1602f;text-transform:uppercase;font-weight:700">View all</a>
    </div>
    <div class="grid-4" data-m-group style="display:grid;grid-template-columns:repeat(4,1fr);gap:28px">
      <% bestsellers.forEach(function(p){ %>
        <%- include('partials/product-card', { p }) %>
      <% }); %>
    </div>
  </div>
  <% } %>

  <!-- the northern light: a dark, scroll-driven chapter. Three statements play over a live aurora
       (js/aurora.js, raw WebGL) as the page scrolls. Without motion/WebGL it is a plain dark section
       with the same three lines stacked over a CSS gradient. -->
  <section class="au-aurora" data-aurora="section" aria-labelledby="au-aurora-h">
    <div class="au-aurora-stage" data-aurora="stage">
      <canvas class="au-aurora-canvas" aria-hidden="true"></canvas>
      <div class="au-aurora-copy au-pad">
        <div class="au-aurora-eyebrow">The Northern Light</div>
        <div class="au-aurora-lines">
          <h2 id="au-aurora-h" class="serif au-aurora-line" data-aurora="line">Light is <em>never</em> one color.</h2>
          <p class="serif au-aurora-line" data-aurora="line"><em>Neither</em> is skin.</p>
          <div class="au-aurora-line au-aurora-last" data-aurora="line">
            <p class="serif">Auréalis is made to let it <em>move.</em></p>
            <a class="au-link au-ulink au-aurora-link" data-aurora="link" href="/shop">Discover the collection →</a>
          </div>
        </div>
      </div>
      <div class="au-aurora-legend" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><span class="au-aurora-bar"><b></b></span></div>
    </div>
  </section>

  <!-- collections: a typographic index. Under a mouse, a product image floats beside the cursor for the row you point at. -->
  <% var _cats = (typeof navCategories !== 'undefined' ? navCategories : []); var _prods = (typeof allProducts !== 'undefined' ? allProducts : []); %>
  <% if (_cats.length) { %>
  <section class="au-index au-pad" data-index aria-labelledby="au-index-h">
    <div class="au-index-head" data-m="rise"><span id="au-index-h">The Collections</span><span>Auréalis</span></div>
    <ul data-m-group>
      <% _cats.forEach(function(c, i){ var _rep = _prods.find(function(p){ return p.image_url && (p.categories || []).some(function(pc){ return pc.category_slug === c.slug; }); }); %>
        <li data-m-item><a class="au-link" href="/shop?category=<%= c.slug %>"<% if (_rep) { %> data-img="<%= _rep.image_url %>"<% } %>><span class="no"><%= (i + 1 < 10 ? '0' : '') + (i + 1) %></span><span class="nm serif"><%= c.name %></span><span class="ar" aria-hidden="true">→</span></a></li>
      <% }); var _any = _prods.find(function(p){ return p.image_url; }); %>
      <li data-m-item><a class="au-link" href="/shop"<% if (_any) { %> data-img="<%= _any.image_url %>"<% } %>><span class="no"><%= (_cats.length + 1 < 10 ? '0' : '') + (_cats.length + 1) %></span><span class="nm serif">Shop All</span><span class="ar" aria-hidden="true">→</span></a></li>
    </ul>
    <div class="au-index-peek" aria-hidden="true"></div>
  </section>
  <% } %>

  <!-- brand story -->
  <div data-horizon style="height:8px;background:linear-gradient(90deg,#f7d595 0%,#a5d1e4 33%,#a5bf97 66%,#bfb5e8 100%)"></div>
  <div data-story="section" class="au-pad grid-2" style="display:grid;grid-template-columns:1fr 1fr;align-items:center;background:rgba(255,255,255,.4);-webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px);padding:80px 64px;gap:60px">
    <div data-story="image" style="position:relative;width:100%;aspect-ratio:4/3;max-height:480px;border-radius:20px;overflow:hidden;background:
        radial-gradient(120% 120% at 30% 20%, rgba(191,181,232,.9), transparent 55%),
        radial-gradient(120% 120% at 80% 80%, rgba(247,213,149,.9), transparent 55%),
        linear-gradient(160deg,#3f6f86,#4c6b45)">
      <% if (about && about.image) { %><img src="<%= about.image %>" alt="Our story" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block"><% } %>
    </div>
    <div>
      <div data-story="quote" class="serif" style="font-size:clamp(22px,5vw,30px);line-height:1.4;margin-bottom:24px">"The aurora taught us that light is never one color. Every formula moves through sage, azure and lavender the way the sky does."</div>
      <a data-story="link" class="au-link au-ulink" href="/about" style="font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#c1602f;font-weight:700">Our Story →</a>
    </div>
  </div>

  <%- include('partials/footer') %>
</div>
<script defer src="/js/aurora.js?v=<%= typeof assetV !== 'undefined' ? assetV : '1' %>"></script>
<script defer src="/js/relight.js?v=<%= typeof assetV !== 'undefined' ? assetV : '1' %>"></script>
<script src="/js/app.js"></script>
</body>
</html>
