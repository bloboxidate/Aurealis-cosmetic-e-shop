<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div style="background-color:#fff9f3;min-height:100vh;background-repeat:repeat-y;background-size:100% 950px;background-image:
    radial-gradient(700px circle at 10% 8%, rgba(165,209,228,.5), transparent 60%),
    radial-gradient(650px circle at 90% 20%, rgba(191,181,232,.45), transparent 58%),
    radial-gradient(750px circle at 40% 70%, rgba(165,191,151,.4), transparent 60%)">

  <%- include('partials/header', { navActive: '' }) %>

  <div class="au-pad" style="padding:56px 64px 100px">
    <div class="serif" style="font-size:clamp(28px,6.5vw,42px);margin-bottom:40px">My Wishlist</div>

    <% if (products.length === 0) { %>
      <div style="background:rgba(255,255,255,.6);border-radius:16px;padding:36px;text-align:center;color:#6b6357">
        Nothing saved yet. <a class="au-link" href="/shop" style="color:#c1602f;font-weight:700">Browse products →</a>
      </div>
    <% } else { %>
      <div class="grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:28px">
        <% products.forEach(function(p){ %>
          <div>
            <%- include('partials/product-card', { p, cardH: 230 }) %>
            <form action="/wishlist/toggle" method="post" style="margin-top:10px">
              <input type="hidden" name="product_id" value="<%= p.id %>">
              <input type="hidden" name="next" value="/wishlist">
              <button type="submit" class="au-link" style="background:none;border:none;cursor:pointer;font-size:13px;color:#8a8175;padding:0">Remove</button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
</div>
<script src="/js/app.js"></script>
</body>
</html>
