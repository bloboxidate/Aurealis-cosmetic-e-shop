<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div style="background-color:#fff9f3;min-height:100vh;background-repeat:repeat-y;background-size:100% 950px;background-image:
    radial-gradient(700px circle at 8% 8%, rgba(165,209,228,.4), transparent 60%),
    radial-gradient(650px circle at 92% 20%, rgba(191,181,232,.35), transparent 58%)">
<main id="main">

  <div class="au-header" style="display:flex;align-items:center;justify-content:space-between;padding:20px 64px;border-bottom:1px solid rgba(58,53,46,.12)">
    <a href="/" style="display:flex;align-items:center"><img src="/assets/aurealis-logo-black.webp" alt="Auréalis" style="height:56px;width:auto;display:block"></a>
    <div style="font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#6b6357">Secure Checkout</div>
  </div>
  <%- include('partials/flash') %>
  <style>
    .pay-opt{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 18px;border-radius:10px;font-size:14px;background:#fff;border:1.5px solid rgba(58,53,46,.25);cursor:pointer;margin-bottom:10px}
    .pay-opt:has(input:checked){border-color:#3a352e}
    .pay-box{display:none;margin:2px 0 4px;padding:20px 22px;border-radius:12px;background:rgba(255,255,255,.75);border:1px solid rgba(58,53,46,.15);font-size:14px;line-height:1.6;color:#3a352e}
    .pay-box.is-open{display:block}
    .pay-card{padding:12px 14px;border-radius:10px;background:#fff9f3;margin-bottom:12px}
    .pay-card > div{display:flex;gap:12px;padding:3px 0}
    .pay-k{color:#6b6357;min-width:110px}
    .pay-v{overflow-wrap:anywhere}
    .pay-text p{margin:0 0 10px}.pay-text p:last-child{margin-bottom:0}
    .pay-text a{color:#a8501f}
  </style>
  <noscript><style>.pay-box{display:block}</style></noscript>

  <form action="/checkout" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="au-pad grid-2" style="padding:56px 64px 100px;display:grid;grid-template-columns:1.5fr 1fr;gap:70px">

    <div>
      <div style="margin-bottom:40px">
        <div style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#a8501f;font-weight:700;margin-bottom:12px">Contact</div>
        <div class="co-row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
          <input class="field" type="email" name="email" required placeholder="Email address" value="<%= values.email || '' %>">
          <input class="field" type="tel" name="mobile" required placeholder="Mobile number" value="<%= values.mobile || '' %>">
        </div>
      </div>

      <div style="margin-bottom:40px">
        <div style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#a8501f;font-weight:700;margin-bottom:12px">Shipping Address</div>
        <div class="co-row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
          <input class="field" type="text" name="first_name" required placeholder="First name" value="<%= values.first_name || '' %>">
          <input class="field" type="text" name="last_name" required placeholder="Last name" value="<%= values.last_name || '' %>">
        </div>
        <div class="co-row" style="display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-bottom:14px">
          <input class="field" type="text" name="street" required placeholder="Street" value="<%= values.street || '' %>">
          <input class="field" type="text" name="building" required placeholder="Building" value="<%= values.building || '' %>">
        </div>
        <select class="field" name="city_id" required style="width:100%">
          <option value="">Select your city…</option>
          <% cityGroups.forEach(function(st){ %>
            <optgroup label="<%= st.name %>">
              <% st.cities.forEach(function(c){ %>
                <option value="<%= c.id %>" <%= values.city_id === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </optgroup>
          <% }); %>
        </select>
      </div>

      <div>
        <div style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#a8501f;font-weight:700;margin-bottom:12px">Payment</div>
        <label class="pay-opt">
          <span><input type="radio" name="payment_method" value="cod" <%= values.payment_method === 'instapay' && payment.instapay_enabled ? '' : 'checked' %> style="margin-right:10px"><%= codName %></span>
          <span style="color:#6b6357">Pay on delivery</span>
        </label>
        <% if (payment.instapay_enabled) { %>
        <label class="pay-opt">
          <span><input type="radio" name="payment_method" value="instapay" <%= values.payment_method === 'instapay' ? 'checked' : '' %> id="pay-instapay" aria-controls="instapay-box" style="margin-right:10px"><%= payment.instapay_title %></span>
          <span style="color:#6b6357"><%= payment.instapay_tagline %></span>
        </label>
        <div class="pay-box" id="instapay-box" role="region" aria-label="How to pay with <%= payment.instapay_title %>">
          <div style="font-weight:700;margin-bottom:10px">How to pay with <%= payment.instapay_title %></div>
          <% if (payment.instapay_handle || payment.instapay_name || payment.instapay_bank) { %>
          <div class="pay-card">
            <% if (payment.instapay_handle) { %><div><span class="pay-k">Send to</span><strong class="pay-v"><%= payment.instapay_handle %></strong></div><% } %>
            <% if (payment.instapay_bank) { %><div><span class="pay-k">Bank</span><span class="pay-v"><%= payment.instapay_bank %></span></div><% } %>
            <% if (payment.instapay_name) { %><div><span class="pay-k">Account name</span><span class="pay-v"><%= payment.instapay_name %></span></div><% } %>
            <div><span class="pay-k">Amount</span><strong class="pay-v" data-sum="total"><%= money(total_cents) %></strong></div>
          </div>
          <% } %>
          <div class="pay-text"><%- richText(payment.instapay_instructions) %></div>
        </div>
        <% } %>
      </div>
    </div>

    <div style="background:rgba(255,255,255,.7);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);border-radius:20px;padding:36px;position:sticky;top:24px;height:fit-content">
      <div style="font-size:18px;font-weight:700;margin-bottom:24px">Order Summary</div>
      <% items.forEach(function(it){ %>
      <div style="display:flex;gap:14px;margin-bottom:16px">
        <div style="width:64px;height:64px;border-radius:10px;background:<%= it.color %>;flex:none;overflow:hidden"><% if(it.image_url){ %><img src="<%= it.image_url %>" style="width:100%;height:100%;object-fit:cover"><% } %></div>
        <div style="flex:1;font-size:13px">
          <div style="font-weight:700"><%= it.name %></div><div style="color:#6b6357">Qty <%= it.qty %><%= it.size ? ' · '+it.size : '' %></div>
        </div>
        <div style="font-size:13px;font-weight:700"><%= money(it.line_cents) %></div>
      </div>
      <% }); %>
      <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:12px;color:#5a5148;padding-top:16px;border-top:1px solid rgba(58,53,46,.15)">
        <span>Subtotal</span><span><%= money(subtotal_cents) %></span>
      </div>
      <% if (discount_cents > 0) { %>
      <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:12px;color:#2f4a26">
        <span>Discount (<%= promo %>)</span><span>−<%= money(discount_cents) %></span>
      </div>
      <% } %>
      <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:20px;color:#5a5148">
        <span>Shipping</span><span data-sum="shipping"><%= shipping_cents > 0 ? money(shipping_cents) : 'Select your city' %></span>
      </div>
      <div data-sum-row="cod" style="display:<%= cod_fee_cents > 0 ? 'flex' : 'none' %>;justify-content:space-between;font-size:14px;margin:-8px 0 20px;color:#5a5148">
        <span>Cash on delivery fee</span><span data-sum="cod"><%= money(cod_fee_cents) %></span>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:18px;font-weight:700;padding-top:18px;border-top:1px solid rgba(58,53,46,.15);margin-bottom:26px">
        <span>Total</span><span data-sum="total"><%= money(total_cents) %></span>
      </div>
      <button type="submit" class="btn-primary" style="width:100%">Place Order</button>
    </div>

  </div>
  </form>

</main>
</div>
<script>
(function () {
  var box = document.getElementById('instapay-box');
  var radios = document.querySelectorAll('input[name="payment_method"]');
  function sync() { var on = document.getElementById('pay-instapay').checked; box.classList.toggle('is-open', on); }
  if (box) {
    Array.prototype.forEach.call(radios, function (r) { r.addEventListener('change', sync); });
    sync();
  }

  // Live summary: the shipping fee per city comes from the server (Sariee's rate card, by governorate and cart weight);
  // the cash-on-delivery fee applies only while "pay on delivery" is chosen. The server recomputes both on submit.
  var quotes = <%- JSON.stringify(shipQuotes) %>;
  var net = <%= Math.max(0, subtotal_cents - discount_cents) %>;
  var codPct = <%= codPercent %>;
  var city = document.querySelector('select[name="city_id"]');
  function money(c) { return 'EGP ' + (c / 100).toFixed(2); }
  function set(k, v) { Array.prototype.forEach.call(document.querySelectorAll('[data-sum="' + k + '"]'), function (n) { n.textContent = v; }); }
  function update() {
    var has = city && Object.prototype.hasOwnProperty.call(quotes, city.value);
    var ship = has ? quotes[city.value] : 0;
    var pm = document.querySelector('input[name="payment_method"]:checked');
    var cod = !pm || pm.value === 'cod' ? Math.round((net + ship) * codPct / 100) : 0;
    set('shipping', has ? money(ship) : 'Select your city');
    set('cod', money(cod));
    set('total', money(net + ship + cod));
    var row = document.querySelector('[data-sum-row="cod"]');
    if (row) row.style.display = cod > 0 ? 'flex' : 'none';
  }
  if (city) city.addEventListener('change', update);
  Array.prototype.forEach.call(radios, function (r) { r.addEventListener('change', update); });
  update();
})();
</script>
<script src="/js/app.js"></script>
</body>
</html>
