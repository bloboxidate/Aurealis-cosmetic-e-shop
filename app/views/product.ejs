<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div style="background-color:#fff9f3;background-repeat:repeat-y;background-size:100% 950px;background-image:
    radial-gradient(700px circle at 8% 8%, rgba(165,209,228,.45), transparent 60%),
    radial-gradient(650px circle at 92% 20%, rgba(191,181,232,.4), transparent 58%),
    radial-gradient(750px circle at 30% 55%, rgba(165,191,151,.4), transparent 60%),
    radial-gradient(700px circle at 88% 62%, rgba(247,213,149,.45), transparent 58%)">

  <%- include('partials/header', { navActive: product.category }) %>

  <div class="au-pad" style="padding:36px 64px 0;font-size:13px;color:#8a8175">
    <a class="au-link" href="/" style="color:#8a8175">Home</a> /
    <a class="au-link" href="/shop?category=<%= product.category %>" style="color:#8a8175;text-transform:capitalize"><%= product.category %></a> /
    <%= product.name %>
  </div>

  <div class="au-pad grid-2" style="display:grid;grid-template-columns:1fr 1fr;gap:70px;padding:32px 64px 90px">
    <!-- gallery -->
    <div class="pdp-gallery-col">
      <% const gallery = (typeof images !== 'undefined' ? images : []); %>
      <% if (gallery.length === 0) { %>
        <div style="width:100%;height:520px;border-radius:20px;overflow:hidden;background:<%= product.color %>"></div>
      <% } else { %>
        <div class="pdp-gallery">
          <% if (gallery.length > 1) { %>
            <div class="pdp-thumbs">
              <% gallery.forEach(function(img, i){ %>
                <div class="pdp-thumb<%= i===0 ? ' pdp-thumb-active' : '' %>" data-full="<%= img.url %>" data-index="<%= i %>" style="background:<%= product.color || '#f1ece5' %>">
                  <img src="<%= img.url %>" alt="" style="width:100%;height:100%;object-fit:cover;display:block">
                </div>
              <% }); %>
            </div>
          <% } %>
          <div id="pdp-main" class="pdp-main" style="background:<%= product.color %>">
            <img id="pdp-main-img" src="<%= gallery[0].url %>" alt="<%= product.name %>" style="width:100%;height:100%;object-fit:cover;display:block">
            <% if (gallery.length > 1) { %>
              <button type="button" class="pdp-arrow pdp-arrow-prev" id="pdp-prev" aria-label="Previous image">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3a352e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
              </button>
              <button type="button" class="pdp-arrow pdp-arrow-next" id="pdp-next" aria-label="Next image">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3a352e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
              </button>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- details -->
    <div class="pdp-info" data-m-group>
      <div data-m-item style="font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:#c1602f;font-weight:700;margin-bottom:14px"><%= product.subtitle %></div>
      <div data-m-item role="heading" aria-level="1" class="serif" style="font-size:clamp(28px,6.5vw,44px);margin-bottom:12px"><%= product.name %></div>
      <div data-m-item style="font-size:20px;color:#3a352e;margin-bottom:20px"><%= money(product.price_cents) %></div>
      <div data-m-item style="font-size:15px;line-height:1.7;color:#5a5148;margin-bottom:32px;max-width:460px"><%= product.description %></div>

      <form data-m-item action="/cart/add" method="post" id="add-form">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <input type="hidden" name="size" id="size-input" value="<%= product.sizes[0] || '' %>">

        <% if (product.sizes.length) { %>
        <div style="margin-bottom:28px">
          <div style="font-size:13px;font-weight:700;margin-bottom:10px">Size</div>
          <div style="display:flex;gap:10px;flex-wrap:wrap" id="size-group">
            <% product.sizes.forEach(function(s, i){ %>
              <button type="button" class="size-chip" data-size="<%= s %>"
                style="padding:10px 22px;border-radius:100px;font-size:13px;background:#fff9f3;cursor:pointer;<%= i===0?'border:1.5px solid #3a352e;color:#3a352e':'border:1px solid rgba(58,53,46,.3);color:#6b6357' %>"><%= s %></button>
            <% }); %>
          </div>
        </div>
        <% } %>

        <div style="display:flex;gap:14px;margin-bottom:32px;max-width:460px">
          <div style="display:flex;align-items:center;border:1px solid rgba(58,53,46,.3);border-radius:100px;overflow:hidden">
            <button type="button" class="qty-dec" style="padding:14px 18px;font-size:15px;cursor:pointer;background:none;border:none">−</button>
            <div class="qty-val" style="padding:14px 6px;font-size:14px;min-width:24px;text-align:center">1</div>
            <button type="button" class="qty-inc" style="padding:14px 18px;font-size:15px;cursor:pointer;background:none;border:none">+</button>
            <input type="hidden" name="qty" class="qty-input" value="1">
          </div>
          <button type="submit" class="btn-primary" style="flex:1">Add to Bag</button>
        </div>
      </form>

      <form data-m-item action="/wishlist/toggle" method="post" style="margin-top:-20px;margin-bottom:32px">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <input type="hidden" name="next" value="/product/<%= product.slug %>">
        <button type="submit" class="au-link" style="background:none;border:none;cursor:pointer;font-size:13px;color:#6b6357;padding:0"><%= typeof wishlisted !== 'undefined' && wishlisted ? '♥ Saved to Wishlist' : '♡ Save to Wishlist' %></button>
      </form>

      <% if (product.badges && product.badges.length) { %>
      <div data-m-item style="display:flex;gap:24px;padding:20px 0;border-top:1px solid rgba(58,53,46,.12);border-bottom:1px solid rgba(58,53,46,.12);margin-bottom:0;font-size:12px;color:#6b6357;letter-spacing:.03em;text-transform:uppercase;flex-wrap:wrap">
        <% product.badges.forEach(function(b){ %><div><%= b %></div><% }); %>
      </div>
      <% } %>

      <% if (product.details) { %>
      <details class="pdp-acc" data-m-item open><summary><span>Details</span><i aria-hidden="true"></i></summary><div class="pdp-acc-body"><div><%= product.details %></div></div></details>
      <% } %>
      <% if (product.how_to_use) { %>
      <details class="pdp-acc" data-m-item><summary><span>How to Use</span><i aria-hidden="true"></i></summary><div class="pdp-acc-body"><div><%= product.how_to_use %></div></div></details>
      <% } %>
      <% if (product.ingredients) { %>
      <details class="pdp-acc" data-m-item><summary><span>Ingredients</span><i aria-hidden="true"></i></summary><div class="pdp-acc-body"><div><%= product.ingredients %></div></div></details>
      <% } %>
    </div>
  </div>

  <!-- reviews -->
  <div class="au-pad" data-m="rise" style="padding:0 64px 90px;max-width:760px">
    <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:28px">
      <div class="serif" style="font-size:28px">Reviews</div>
      <% if (reviewSummary.count > 0) { %>
        <div style="font-size:14px;color:#6b6357"><%= reviewSummary.average %> ★ · <%= reviewSummary.count %> review<%= reviewSummary.count === 1 ? '' : 's' %></div>
      <% } %>
    </div>

    <% if (productReviews.length === 0) { %>
      <div style="font-size:14px;color:#6b6357;margin-bottom:28px">No reviews yet.</div>
    <% } else { %>
      <% productReviews.forEach(function(r){ %>
        <div style="border-bottom:1px solid rgba(58,53,46,.1);padding:16px 0">
          <div style="font-size:13px;font-weight:700;margin-bottom:4px"><%= '★'.repeat(r.rating) %><span style="color:#d8d0c4"><%= '★'.repeat(5 - r.rating) %></span> <span style="font-weight:400;color:#6b6357">by <%= r.first_name || 'a customer' %></span></div>
          <div style="font-size:14px;color:#5a5148;line-height:1.6"><%= r.body %></div>
        </div>
      <% }); %>
    <% } %>

    <% if (typeof user !== 'undefined' && user && canReview) { %>
      <div style="margin-top:24px;background:rgba(255,255,255,.6);border-radius:16px;padding:24px 28px">
        <div style="font-size:15px;font-weight:700;margin-bottom:14px">Write a review</div>
        <form action="/product/<%= product.slug %>/reviews" method="post">
          <div style="margin-bottom:14px">
            <select name="rating" class="field" required>
              <option value="">Rating…</option>
              <option value="5">★★★★★ Excellent</option>
              <option value="4">★★★★ Good</option>
              <option value="3">★★★ Okay</option>
              <option value="2">★★ Poor</option>
              <option value="1">★ Bad</option>
            </select>
          </div>
          <textarea name="body" class="field" rows="3" required placeholder="Share your experience…" style="width:100%;margin-bottom:14px;resize:vertical"></textarea>
          <button type="submit" class="btn-primary">Submit review</button>
          <div style="font-size:12px;color:#8a8175;margin-top:10px">Reviews are checked before appearing publicly.</div>
        </form>
      </div>
    <% } else if (typeof user === 'undefined' || !user) { %>
      <div style="font-size:13px;color:#6b6357;margin-top:12px"><a class="au-link" href="/login?next=/product/<%= product.slug %>" style="color:#c1602f;font-weight:700">Sign in</a> to write a review.</div>
    <% } %>
  </div>

  <!-- related -->
  <% if (related.length) { %>
  <div class="au-pad" style="padding:0 64px 90px">
    <div class="serif" data-m="rise" style="font-size:32px;margin-bottom:32px">You may also like</div>
    <div class="grid-4" data-m-group style="display:grid;grid-template-columns:repeat(4,1fr);gap:28px">
      <% related.forEach(function(p){ %>
        <%- include('partials/product-card', { p }) %>
      <% }); %>
    </div>
  </div>
  <% } %>

  <div class="pdp-bar" id="pdp-bar" aria-hidden="true">
    <div class="pdp-bar-info"><div class="pdp-bar-name"><%= product.name %></div><div class="pdp-bar-price"><%= money(product.price_cents) %></div></div>
    <button type="submit" form="add-form" class="btn-primary" tabindex="-1">Add to Bag</button>
  </div>

  <%- include('partials/footer') %>
</div>
<script defer src="/js/motion-product.js?v=<%= typeof assetV !== 'undefined' ? assetV : '1' %>"></script>
<script src="/js/app.js"></script>
</body>
</html>
