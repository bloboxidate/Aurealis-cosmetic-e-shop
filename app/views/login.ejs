<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div style="background-color:#fff9f3;min-height:100vh;display:flex;flex-direction:column;background-repeat:repeat-y;background-size:100% 950px;background-image:
    radial-gradient(700px circle at 12% 10%, rgba(165,209,228,.6), transparent 60%),
    radial-gradient(650px circle at 88% 22%, rgba(191,181,232,.55), transparent 58%),
    radial-gradient(750px circle at 30% 70%, rgba(165,191,151,.5), transparent 60%),
    radial-gradient(700px circle at 90% 90%, rgba(247,213,149,.55), transparent 58%)">

  <div style="padding:32px 64px"><a href="/" style="display:flex;align-items:center;width:fit-content"><img src="/assets/aurealis-logo-black.webp" alt="Auréalis" style="height:56px;width:auto;display:block"></a></div>
  <%- include('partials/flash') %>

  <div style="flex:1;display:flex;align-items:center;justify-content:center;padding:20px 24px 80px">
    <div style="width:420px;max-width:100%;background:rgba(255,255,255,.7);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);border-radius:20px;padding:44px">
      <div role="heading" aria-level="1" class="serif" style="font-size:32px;margin-bottom:8px;text-align:center">Welcome back</div>
      <div style="font-size:14px;color:#6b6357;text-align:center;margin-bottom:32px">Sign in to your Auréalis account</div>

      <form action="/login" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="next" value="<%= next %>">
        <div style="margin-bottom:16px">
          <div style="font-size:12px;font-weight:700;margin-bottom:8px">Email</div>
          <input class="field" type="email" name="email" required placeholder="you@email.com" value="<%= values.email || '' %>">
        </div>
        <div style="margin-bottom:10px">
          <div style="font-size:12px;font-weight:700;margin-bottom:8px">Password</div>
          <input class="field" type="password" name="password" required placeholder="••••••••">
        </div>
        <div style="text-align:right;margin-bottom:24px"><a class="au-link" href="/forgot-password" style="font-size:12px;color:#8a8175">Forgot password?</a></div>
        <button type="submit" class="btn-primary" style="width:100%;margin-bottom:24px">Sign In</button>
      </form>

      <div style="text-align:center;font-size:13px;color:#6b6357;margin-bottom:14px">New to Auréalis? <a class="au-link" href="/signup" style="color:#c1602f;font-weight:700">Create an account</a></div>
    </div>
  </div>
</div>
</body>
</html>
