<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div style="background-color:#fff9f3;min-height:100vh;background-repeat:repeat-y;background-size:100% 950px;background-image:
    radial-gradient(700px circle at 15% 10%, rgba(165,191,151,.5), transparent 60%),
    radial-gradient(650px circle at 85% 25%, rgba(165,209,228,.45), transparent 58%),
    radial-gradient(750px circle at 50% 85%, rgba(247,213,149,.45), transparent 60%)">

  <%- include('partials/header', { navActive: '' }) %>

  <div class="au-pad" style="padding:70px 64px 100px;max-width:760px;margin:0 auto">
    <div style="text-align:center;margin-bottom:40px">
      <div style="width:64px;height:64px;border-radius:50%;background:#a5bf97;color:#2f4a26;display:flex;align-items:center;justify-content:center;font-size:30px;margin:0 auto 20px">✓</div>
      <div class="serif" style="font-size:clamp(28px,6vw,40px);margin-bottom:8px">Thank you<%= order.ship_first ? ', ' + order.ship_first : '' %>!</div>
      <div style="font-size:15px;color:#6b6357">Your order <b><%= order.order_number %></b> is confirmed.</div>
      <div style="font-size:13px;color:#8a8175;margin-top:6px">A confirmation was sent to <%= order.email %> (demo — no real email is delivered).</div>
    </div>

    <div style="background:rgba(255,255,255,.7);border-radius:20px;padding:36px">
      <div style="font-size:16px;font-weight:700;margin-bottom:20px">Order Summary</div>
      <% order.items.forEach(function(it){ %>
        <div style="display:flex;justify-content:space-between;font-size:14px;padding:8px 0;border-bottom:1px solid rgba(58,53,46,.1)">
          <span><%= it.name %><%= it.size ? ' · '+it.size : '' %> × <%= it.qty %></span>
          <span style="font-weight:700"><%= money(it.unit_price_cents * it.qty) %></span>
        </div>
      <% }); %>
      <div style="display:flex;justify-content:space-between;font-size:14px;color:#5a5148;margin-top:16px"><span>Subtotal</span><span><%= money(order.subtotal_cents) %></span></div>
      <% if (order.discount_cents > 0) { %><div style="display:flex;justify-content:space-between;font-size:14px;color:#2f4a26;margin-top:8px"><span>Discount (<%= order.promo_code %>)</span><span>−<%= money(order.discount_cents) %></span></div><% } %>
      <div style="display:flex;justify-content:space-between;font-size:14px;color:#5a5148;margin-top:8px"><span>Shipping (<%= order.ship_method %>)</span><span><%= order.shipping_cents > 0 ? money(order.shipping_cents) : 'Free' %></span></div>
      <div style="display:flex;justify-content:space-between;font-size:18px;font-weight:700;margin-top:16px;padding-top:16px;border-top:1px solid rgba(58,53,46,.15)"><span>Total</span><span><%= money(order.total_cents) %></span></div>

      <div style="margin-top:24px;font-size:13px;color:#6b6357;line-height:1.6">
        <div style="font-weight:700;color:#3a352e;margin-bottom:4px">Shipping to</div>
        <%= order.ship_first %> <%= order.ship_last %><br>
        <%= order.address %><br>
        <%= order.city %>, <%= order.postal %>, <%= order.country %>
      </div>
    </div>

    <div style="text-align:center;margin-top:32px"><a class="au-link btn-outline" href="/shop">Continue Shopping</a></div>
  </div>

  <%- include('partials/footer') %>
</div>
</body>
</html>
