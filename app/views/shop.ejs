<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div style="background-color:#fff9f3;background-repeat:repeat-y;background-size:100% 950px;background-image:
    radial-gradient(700px circle at 8% 8%, rgba(165,209,228,.5), transparent 60%),
    radial-gradient(650px circle at 92% 20%, rgba(191,181,232,.45), transparent 58%),
    radial-gradient(750px circle at 30% 55%, rgba(165,191,151,.45), transparent 60%),
    radial-gradient(700px circle at 88% 62%, rgba(247,213,149,.5), transparent 58%),
    radial-gradient(750px circle at 15% 92%, rgba(248,174,127,.45), transparent 58%)">

  <%- include('partials/header', { navActive: category || 'shop' }) %>

  <main id="main">

  <div class="au-pad" style="padding:44px 64px 0">
    <div data-m="rise" style="font-size:13px;color:#6b6357;margin-bottom:18px"><a class="au-link" href="/" style="color:#6b6357">Home</a> / <%= heading %></div>
    <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:20px;margin-bottom:36px">
      <div>
        <div data-m="lines" role="heading" aria-level="1" class="serif" style="font-size:clamp(34px,8vw,64px);line-height:1.05;margin-bottom:10px"><%= heading %></div>
        <% if (typeof intro !== 'undefined' && intro) { %><div data-m="rise" class="rich" style="color:#6b6357"><%- richText(intro) %></div><% } else { %><div data-m="rise" style="font-size:15px;color:#6b6357"><%= count %> products formulated for radiance, hydration and balance.</div><% } %>
      </div>
      <form data-m="rise" method="get" action="/shop" style="display:flex;align-items:center;flex-wrap:wrap;gap:10px 14px;font-size:13px;max-width:100%">
        <% if (category) { %><input type="hidden" name="category" value="<%= category %>"><% } %>
        <% if (activeSub && activeSub !== 'all') { %><input type="hidden" name="sub" value="<%= activeSub %>"><% } %>
        <input type="text" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Search products…" style="flex:1 1 160px;min-width:0;border:1px solid rgba(58,53,46,.25);background:#fff9f3;padding:10px 14px;border-radius:100px;font-size:13px;color:#3a352e">
        <span style="color:#6b6357">Sort by</span>
        <select name="sort" aria-label="Sort products" onchange="this.form.submit()" style="border:1px solid rgba(58,53,46,.25);background:#fff9f3;padding:10px 14px;border-radius:100px;font-size:13px;color:#3a352e">
          <option value="featured" <%= sort==='featured'?'selected':'' %>>Featured</option>
          <option value="price-asc" <%= sort==='price-asc'?'selected':'' %>>Price: Low to High</option>
          <option value="price-desc" <%= sort==='price-desc'?'selected':'' %>>Price: High to Low</option>
          <option value="newest" <%= sort==='newest'?'selected':'' %>>Newest</option>
        </select>
      </form>
    </div>

    <!-- filter chips -->
    <% const chipColors = ['rgba(165,209,228,.5)','rgba(165,191,151,.5)','rgba(191,181,232,.5)','rgba(247,213,149,.6)','rgba(248,174,127,.5)']; %>
    <% function chipUrl(sub){ const p=[]; if(category)p.push('category='+category); if(sub&&sub!=='all')p.push('sub='+sub); if(sort&&sort!=='featured')p.push('sort='+sort); if(typeof q!=='undefined'&&q)p.push('q='+encodeURIComponent(q)); return '/shop'+(p.length?'?'+p.join('&'):''); } %>
    <div data-m="rise" style="display:flex;gap:12px;margin-bottom:44px;flex-wrap:wrap">
      <a class="au-link" href="<%= chipUrl('all') %>" style="padding:9px 20px;border-radius:100px;font-size:13px;<%= activeSub==='all'?'background:#3a352e;color:#fff9f3':'background:rgba(58,53,46,.08);color:#3a352e' %>">All</a>
      <% subcats.forEach(function(s, i){ %>
        <a class="au-link" href="<%= chipUrl(s.slug) %>" style="padding:9px 20px;border-radius:100px;font-size:13px;<%= activeSub===s.slug?'background:#3a352e;color:#fff9f3':'background:'+chipColors[i%chipColors.length]+';color:#3a352e' %>"><%= s.name %></a>
      <% }); %>
    </div>
  </div>

  <!-- product grid -->
  <div class="au-pad" style="padding:0 64px 90px">
    <% if (typeof catalogError !== 'undefined' && catalogError) { %>
      <div style="padding:60px 0;text-align:center;color:#6b6357;font-size:16px">We're having trouble loading products right now. <a class="au-link" href="/shop" style="color:#a8501f;font-weight:700">Try again</a></div>
    <% } else if (products.length === 0) { %>
      <div style="padding:60px 0;text-align:center;color:#6b6357;font-size:16px"><%= (typeof q !== 'undefined' && q) ? 'No products match “' + q + '”.' : 'No products found.' %> <a class="au-link" href="/shop" style="color:#a8501f;font-weight:700">View all</a></div>
    <% } else { %>
    <div class="grid-4" data-m-group style="display:grid;grid-template-columns:repeat(4,1fr);gap:28px">
      <% products.forEach(function(p){ %>
        <%- include('partials/product-card', { p, cardShowSub: true }) %>
      <% }); %>
    </div>
    <% if (totalPages > 1) { %>
      <% function pageUrl(n){ const p=[]; if(category)p.push('category='+category); if(activeSub&&activeSub!=='all')p.push('sub='+activeSub); if(sort&&sort!=='featured')p.push('sort='+sort); if(typeof q!=='undefined'&&q)p.push('q='+encodeURIComponent(q)); if(n>1)p.push('page='+n); return '/shop'+(p.length?'?'+p.join('&'):''); } %>
      <div style="display:flex;justify-content:center;gap:8px;margin-top:48px;flex-wrap:wrap">
        <% for (let p = 1; p <= totalPages; p++) { %>
          <a class="au-link" href="<%= pageUrl(p) %>" style="width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:13px;<%= p===page?'background:#3a352e;color:#fff9f3':'background:rgba(58,53,46,.08);color:#3a352e' %>"><%= p %></a>
        <% } %>
      </div>
    <% } %>
    <% } %>
  </div>

  </main>
  <%- include('partials/footer') %>
</div>
<script src="/js/app.js"></script>
</body>
</html>
