<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div style="background-color:#fff9f3;min-height:100vh;display:flex;flex-direction:column;background-repeat:repeat-y;background-size:100% 950px;background-image:
    radial-gradient(700px circle at 12% 10%, rgba(165,209,228,.6), transparent 60%),
    radial-gradient(650px circle at 88% 22%, rgba(191,181,232,.55), transparent 58%),
    radial-gradient(750px circle at 30% 70%, rgba(165,191,151,.5), transparent 60%),
    radial-gradient(700px circle at 90% 90%, rgba(247,213,149,.55), transparent 58%)">

  <div style="padding:32px 64px"><a href="/" style="display:flex;align-items:center;width:fit-content"><img src="/assets/aurealis-logo-black.webp" alt="Auréalis" style="height:56px;width:auto;display:block"></a></div>
  <%- include('partials/flash') %>

  <div style="flex:1;display:flex;align-items:center;justify-content:center;padding:20px 24px 80px">
    <div style="width:440px;max-width:100%;background:rgba(255,255,255,.7);backdrop-filter:blur(3px);border-radius:20px;padding:44px">
      <div class="serif" style="font-size:32px;margin-bottom:8px;text-align:center">Create your account</div>
      <div style="font-size:14px;color:#6b6357;text-align:center;margin-bottom:32px">Join Auréalis for early access &amp; rewards</div>

      <form action="/signup" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
          <div>
            <div style="font-size:12px;font-weight:700;margin-bottom:8px">First name</div>
            <input class="field" type="text" name="first_name" placeholder="Jane" value="<%= values.first_name || '' %>">
          </div>
          <div>
            <div style="font-size:12px;font-weight:700;margin-bottom:8px">Last name</div>
            <input class="field" type="text" name="last_name" placeholder="Doe" value="<%= values.last_name || '' %>">
          </div>
        </div>
        <div style="margin-bottom:16px">
          <div style="font-size:12px;font-weight:700;margin-bottom:8px">Email</div>
          <input class="field" type="email" name="email" required placeholder="you@email.com" value="<%= values.email || '' %>">
        </div>
        <div style="margin-bottom:20px">
          <div style="font-size:12px;font-weight:700;margin-bottom:8px">Password</div>
          <input class="field" type="password" name="password" required placeholder="•••••••• (min 6 characters)">
        </div>
        <label style="display:flex;align-items:flex-start;gap:8px;font-size:12px;color:#6b6357;margin-bottom:24px">
          <input type="checkbox" name="agree" value="1" style="margin-top:2px">
          <span>I agree to the Terms of Service and Privacy Policy</span>
        </label>
        <button type="submit" class="btn-primary" style="width:100%;margin-bottom:24px">Create Account</button>
      </form>

      <div style="text-align:center;font-size:13px;color:#6b6357">Already have an account? <a class="au-link" href="/login" style="color:#c1602f;font-weight:700">Sign in</a></div>
    </div>
  </div>
</div>
</body>
</html>
