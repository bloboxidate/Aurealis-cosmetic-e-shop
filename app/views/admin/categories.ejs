<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<% const inp='padding:9px 12px;border-radius:8px;border:1px solid rgba(58,53,46,.25);font-size:13px;background:#fff';
   const mini='background:none;border:none;color:#c1602f;font-weight:700;cursor:pointer;font-size:13px';
   const del='background:none;border:none;color:#b0533a;cursor:pointer;font-size:13px'; %>
<div class="admin-shell" style="display:flex;min-height:100vh;background:#fbf7f1">
  <%- include('../partials/admin-nav', { adminActive }) %>
  <div class="admin-main" style="flex:1;padding:40px 48px;max-width:920px">
    <div class="serif" style="font-size:36px;margin-bottom:8px">Categories</div>
    <div style="font-size:14px;color:#8a8175;margin-bottom:24px">Your local storefront taxonomy. Assign products to these on the <a class="au-link" href="/admin/products" style="color:#c1602f">Products</a> page.</div>
    <%- include('../partials/flash') %>

    <!-- add category -->
    <form action="/admin/categories" method="post" style="background:#fff;border-radius:14px;border:1px solid rgba(58,53,46,.08);padding:18px;display:flex;gap:10px;align-items:end;margin-bottom:28px;flex-wrap:wrap">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><label style="display:block;font-size:11px;font-weight:700;margin-bottom:5px">New category name</label><input name="name" required placeholder="e.g. Skincare" style="<%= inp %>"></div>
      <div><label style="display:block;font-size:11px;font-weight:700;margin-bottom:5px">Slug (optional)</label><input name="slug" placeholder="auto" style="<%= inp %>"></div>
      <div><label style="display:block;font-size:11px;font-weight:700;margin-bottom:5px">Sort</label><input name="sort_order" type="number" value="0" style="<%= inp %>;width:70px"></div>
      <button type="submit" class="btn-primary" style="padding:10px 20px">Add category</button>
    </form>

    <% if (categories.length === 0) { %>
      <div style="background:#fff;border-radius:14px;border:1px solid rgba(58,53,46,.08);padding:28px;color:#8a8175;font-size:14px">No categories yet — add your first above. Until you create categories, the storefront nav stays empty and the shop shows all products.</div>
    <% } %>

    <% categories.forEach(function(c){ %>
      <div style="background:#fff;border-radius:14px;border:1px solid rgba(58,53,46,.08);padding:22px;margin-bottom:18px">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
          <form action="/admin/categories/<%= c.id %>/edit" method="post" style="display:flex;gap:8px;align-items:end;flex-wrap:wrap">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input name="name" value="<%= c.name %>" style="<%= inp %>;font-weight:700">
            <input name="slug" value="<%= c.slug %>" style="<%= inp %>;width:120px" title="slug">
            <div style="display:flex;flex-direction:column;gap:3px">
              <span style="font-size:9px;font-weight:700;color:#8a8175;text-transform:uppercase;letter-spacing:.05em">Order</span>
              <input name="sort_order" type="number" value="<%= c.sort_order %>" style="<%= inp %>;width:64px">
            </div>
            <button type="submit" style="<%= mini %>">Save</button>
          </form>
          <form action="/admin/categories/<%= c.id %>/delete" method="post" onsubmit="return confirm('Delete category “<%= c.name %>”?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" style="<%= del %>">Delete</button></form>
        </div>

        <div style="margin-top:16px;padding-top:16px;border-top:1px solid rgba(58,53,46,.08)">
          <div style="font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:#8a8175;margin-bottom:10px">Subcategories</div>
          <% const subs = subcategories.filter(function(s){ return s.category_id === c.id }); %>
          <% if (subs.length === 0) { %><div style="font-size:13px;color:#a49c8f;margin-bottom:10px">None yet.</div><% } %>
          <% subs.forEach(function(s){ %>
            <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;padding:6px 0">
              <form action="/admin/subcategories/<%= s.id %>/edit" method="post" style="display:flex;gap:8px;align-items:end;flex-wrap:wrap">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="category_id" value="<%= c.id %>">
                <input name="name" value="<%= s.name %>" style="<%= inp %>">
                <input name="slug" value="<%= s.slug %>" style="<%= inp %>;width:120px" title="slug">
                <div style="display:flex;flex-direction:column;gap:3px">
                  <span style="font-size:9px;font-weight:700;color:#8a8175;text-transform:uppercase;letter-spacing:.05em">Order</span>
                  <input name="sort_order" type="number" value="<%= s.sort_order %>" style="<%= inp %>;width:64px">
                </div>
                <button type="submit" style="<%= mini %>">Save</button>
              </form>
              <form action="/admin/subcategories/<%= s.id %>/delete" method="post" onsubmit="return confirm('Delete subcategory “<%= s.name %>”?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" style="<%= del %>">Delete</button></form>
            </div>
          <% }); %>

          <form action="/admin/subcategories" method="post" style="display:flex;gap:8px;align-items:center;margin-top:12px;flex-wrap:wrap">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="category_id" value="<%= c.id %>">
            <input name="name" required placeholder="New subcategory" style="<%= inp %>">
            <input name="slug" placeholder="slug (auto)" style="<%= inp %>;width:120px">
            <button type="submit" style="border:1px solid rgba(58,53,46,.3);background:none;border-radius:100px;padding:8px 16px;font-size:12px;cursor:pointer">+ Add</button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>
</div>
</body>
</html>
