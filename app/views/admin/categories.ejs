<%- include('../partials/admin-open') %>
<div class="adm-head">
  <div>
    <h1 class="adm-h1">Categories</h1>
    <p class="adm-sub">The groups in your store menu and on the collections list. Give each a picture, then assign products to them on the <a href="/admin/products">Products</a> page.</p>
  </div>
</div>

<div class="stack" style="max-width:900px">
  <form action="/admin/categories" method="post" class="card card-pad">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-h"><div><h2 class="card-t">New category</h2></div></div>
    <div class="grid" style="grid-template-columns:2fr 1.4fr 90px auto;align-items:end">
      <div class="fld" style="margin:0"><label for="nc-name">Name</label><input class="input" id="nc-name" name="name" required placeholder="e.g. Skincare"></div>
      <div class="fld" style="margin:0"><label for="nc-slug">Web address <span class="opt">optional</span></label><input class="input" id="nc-slug" name="slug" placeholder="made from the name"></div>
      <div class="fld" style="margin:0"><label for="nc-sort">Order</label><input class="input" id="nc-sort" name="sort_order" type="number" value="0"></div>
      <button type="submit" class="btn btn-solid">Add category</button>
    </div>
  </form>

  <% if (categories.length === 0) { %>
    <div class="card empty"><div class="big">No categories yet</div><div>Until you add some, the store menu stays empty and every product shows under “Shop All”.</div></div>
  <% } %>

  <% categories.forEach(function (c) { var subs = subcategories.filter(function (s) { return s.category_id === c.id; }); %>
    <section class="card cat">
      <div class="row wrap between" style="align-items:flex-start;gap:18px">
        <div class="imgup" data-upload-url="/admin/categories/<%= c.id %>/image" style="gap:14px">
          <% if (c.image_url) { %><img class="cat-img" src="<%= c.image_url %>" alt="" style="width:64px;height:64px"><div class="ph" hidden style="width:64px;height:64px">Photo</div><% } else { %><img class="cat-img" src="" alt="" hidden style="width:64px;height:64px"><div class="ph" style="width:64px;height:64px">Photo</div><% } %>
          <div><div class="lbl" style="margin-bottom:6px">Tile picture</div><input type="file" accept="image/*" class="input" style="padding:6px 8px;font-size:12px;max-width:230px" aria-label="Upload a picture for <%= c.name %>"><div class="hint imgup-status"></div></div>
        </div>
        <form action="/admin/categories/<%= c.id %>/delete" method="post" data-confirm="Products in it stay in the store; they just lose this category." data-confirm-title="Delete “<%= c.name %>”?" data-confirm-yes="Delete" data-danger>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm btn-danger">Delete</button>
        </form>
      </div>

      <form action="/admin/categories/<%= c.id %>/edit" method="post" class="row wrap" style="margin-top:16px;align-items:flex-end">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="fld grow" style="margin:0;min-width:160px"><label>Name</label><input class="input strong" name="name" value="<%= c.name %>" aria-label="Name of <%= c.name %>"></div>
        <div class="fld" style="margin:0;width:170px"><label>Web address</label><input class="input" name="slug" value="<%= c.slug %>" aria-label="Web address of <%= c.name %>"></div>
        <div class="fld" style="margin:0;width:80px"><label>Order</label><input class="input" name="sort_order" type="number" value="<%= c.sort_order %>" aria-label="Order of <%= c.name %>"></div>
        <button type="submit" class="btn">Save</button>
      </form>

      <hr class="hr">
      <div class="lbl" style="margin-bottom:8px">Subcategories</div>
      <% if (!subs.length) { %><div class="muted small" style="margin-bottom:8px">None yet.</div><% } %>
      <% subs.forEach(function (s) { %>
        <div class="sub">
          <form action="/admin/subcategories/<%= s.id %>/edit" method="post" class="row wrap grow" style="gap:8px">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="category_id" value="<%= c.id %>">
            <input class="input" name="name" value="<%= s.name %>" style="max-width:220px" aria-label="Subcategory name">
            <input class="input" name="slug" value="<%= s.slug %>" style="max-width:150px" aria-label="Subcategory address">
            <input class="input" name="sort_order" type="number" value="<%= s.sort_order %>" style="max-width:76px" aria-label="Order">
            <button type="submit" class="btn btn-sm">Save</button>
          </form>
          <form action="/admin/subcategories/<%= s.id %>/delete" method="post" data-confirm="Products keep their main category." data-confirm-title="Delete “<%= s.name %>”?" data-confirm-yes="Delete" data-danger>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm btn-ghost">Delete</button>
          </form>
        </div>
      <% }); %>
      <form action="/admin/subcategories" method="post" class="row wrap" style="margin-top:10px;gap:8px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="category_id" value="<%= c.id %>">
        <input class="input" name="name" required placeholder="New subcategory" style="max-width:220px" aria-label="New subcategory name">
        <input class="input" name="slug" placeholder="web address (auto)" style="max-width:170px" aria-label="New subcategory address">
        <button type="submit" class="btn btn-sm">Add subcategory</button>
      </form>
    </section>
  <% }); %>
</div>
<%- include('../partials/admin-close') %>
