<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<% const inp='padding:8px 10px;border-radius:8px;border:1px solid rgba(58,53,46,.25);font-size:13px;background:#fff'; %>
<div class="admin-shell" style="display:flex;min-height:100vh;background:#fbf7f1">
  <%- include('../partials/admin-nav', { adminActive }) %>
  <div class="admin-main" style="flex:1;padding:40px 48px;max-width:1000px">
    <div style="display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:12px;margin-bottom:8px">
      <div class="serif" style="font-size:36px">Products</div>
      <button id="save-order" style="display:none;background:#3a352e;color:#fff9f3;border:none;border-radius:100px;padding:10px 22px;font-size:13px;cursor:pointer">Save new order</button>
    </div>
    <div style="font-size:14px;color:#8a8175;margin-bottom:24px">Products come from Sariee. Here you set how they appear: drag to reorder, assign a category/subcategory, and toggle featured / bestseller / hidden. Prices, images and stock are managed in Sariee.</div>
    <%- include('../partials/flash') %>

    <% if (products.length === 0) { %>
      <div style="background:#fff;border-radius:14px;border:1px solid rgba(58,53,46,.08);padding:28px;color:#8a8175;font-size:14px">No products found in your Sariee store.</div>
    <% } %>

    <div id="rows">
      <% products.forEach(function(p){ %>
        <div class="prow" draggable="true" data-id="<%= p.id %>" style="background:#fff;border-radius:14px;border:1px solid rgba(58,53,46,.08);padding:16px;margin-bottom:14px;display:flex;gap:16px;align-items:center">
          <div class="drag" title="Drag to reorder" style="cursor:grab;color:#c9c1b4;font-size:20px;user-select:none">⠿</div>
          <div style="width:52px;height:52px;border-radius:10px;background:#f0ece5;flex:none;overflow:hidden"><% if (p.image_url) { %><img src="<%= p.image_url %>" style="width:100%;height:100%;object-fit:cover"><% } %></div>
          <div style="flex:1;min-width:140px">
            <div style="font-weight:700;font-size:15px"><%= p.name %><% if (p.is_hidden) { %> <span style="font-size:11px;color:#b0533a;font-weight:700">· hidden</span><% } %></div>
            <div style="font-size:12px;color:#8a8175"><%= price(p.price_cents) %> · Sariee cat: <%= p.sariee_category || '—' %></div>
          </div>
          <form method="post" action="/admin/products/<%= p.id %>" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <select name="category_slug" style="<%= inp %>">
              <option value="">— category —</option>
              <% categories.forEach(function(c){ %>
                <option value="<%= c.slug %>" <%= p.category === c.slug ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
            <select name="subcategory_slug" style="<%= inp %>">
              <option value="">— subcategory —</option>
              <% categories.forEach(function(c){ var subs = subcategories.filter(function(s){return s.category_id===c.id}); if (subs.length) { %>
                <optgroup label="<%= c.name %>">
                  <% subs.forEach(function(s){ %><option value="<%= s.slug %>" <%= p.subcategory === s.slug ? 'selected' : '' %>><%= s.name %></option><% }); %>
                </optgroup>
              <% } }); %>
            </select>
            <label style="font-size:12px;display:flex;align-items:center;gap:4px" title="Featured"><input type="checkbox" name="is_featured" <%= p.is_featured ? 'checked' : '' %>>Feat</label>
            <label style="font-size:12px;display:flex;align-items:center;gap:4px" title="Bestseller"><input type="checkbox" name="is_bestseller" <%= p.is_bestseller ? 'checked' : '' %>>Best</label>
            <label style="font-size:12px;display:flex;align-items:center;gap:4px" title="Hidden"><input type="checkbox" name="is_hidden" <%= p.is_hidden ? 'checked' : '' %>>Hide</label>
            <button type="submit" style="background:none;border:1px solid rgba(58,53,46,.3);border-radius:100px;padding:7px 16px;font-size:12px;cursor:pointer">Save</button>
          </form>
        </div>
      <% }); %>
    </div>
  </div>
</div>

<script>
(function () {
  var rows = document.getElementById('rows');
  var saveBtn = document.getElementById('save-order');
  if (!rows) return;
  var dragged = null;

  rows.addEventListener('dragstart', function (e) {
    var row = e.target.closest('.prow'); if (!row) return;
    dragged = row; row.style.opacity = '.4';
  });
  rows.addEventListener('dragend', function () {
    if (dragged) dragged.style.opacity = '';
    dragged = null;
  });
  rows.addEventListener('dragover', function (e) {
    e.preventDefault();
    var over = e.target.closest('.prow');
    if (!over || over === dragged) return;
    var rect = over.getBoundingClientRect();
    var after = (e.clientY - rect.top) / rect.height > 0.5;
    rows.insertBefore(dragged, after ? over.nextSibling : over);
    saveBtn.style.display = 'inline-block';
  });

  saveBtn.addEventListener('click', function () {
    var ids = Array.prototype.map.call(rows.querySelectorAll('.prow'), function (r) { return r.getAttribute('data-id'); });
    fetch('/admin/products/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids: ids })
    }).then(function (r) { return r.json(); }).then(function () {
      saveBtn.textContent = 'Saved ✓';
      setTimeout(function () { saveBtn.textContent = 'Save new order'; saveBtn.style.display = 'none'; }, 1400);
    });
  });
})();
</script>
</body>
</html>
