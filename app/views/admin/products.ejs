<%- include('../partials/admin-open') %>
<div class="adm-head">
  <div>
    <h1 class="adm-h1">Products</h1>
    <p class="adm-sub">Products come from Sariee. Here you choose how they appear: the order, their categories, what’s featured or hidden, and extra text for the product page. Prices, photos and stock are changed in Sariee.</p>
  </div>
</div>

<% if (sarieeError) { %><div class="notice" style="margin-bottom:16px"><span>Couldn’t load products from Sariee right now (<%= sarieeError %>). Try refreshing in a moment.</span></div><% } %>

<div class="toolbar" id="ptools" role="search">
  <input class="input" type="search" id="psearch" placeholder="Search products…" aria-label="Search products" autocomplete="off">
  <div class="row wrap" id="pfilters" style="gap:6px"></div>
</div>

<div class="bulkbar" id="pbulk" hidden>
  <label class="row" style="gap:8px;font-weight:700"><input type="checkbox" class="cb" id="pselall" aria-label="Select all shown"><span id="pbulk-n">0 selected</span></label>
  <button type="button" class="btn btn-sm" data-bulk="show">Show</button>
  <button type="button" class="btn btn-sm" data-bulk="hide">Hide</button>
  <button type="button" class="btn btn-sm" data-bulk="feature">Feature</button>
  <button type="button" class="btn btn-sm" data-bulk="bestseller">Bestseller</button>
  <% if (categories.length) { %>
    <select class="select" id="pbulk-cat" aria-label="Category"><option value="">Category…</option><% categories.forEach(function (c) { %><option value="<%= c.slug %>"><%= c.name %></option><% }); %></select>
    <button type="button" class="btn btn-sm" data-bulk="add_category">Add</button>
    <button type="button" class="btn btn-sm" data-bulk="remove_category">Remove</button>
  <% } %>
  <button type="button" class="btn btn-sm btn-ghost" id="pbulk-clear" style="margin-left:auto;color:#fff">Clear</button>
</div>

<noscript><div class="notice">The product manager needs JavaScript. Please turn it on for this page.</div></noscript>
<div class="card plist" id="plist" aria-live="polite"></div>
<p class="hint" id="pnote" style="margin-top:12px"></p>

<div class="scrim" id="pscrim"></div>
<aside class="drawer" id="pdrawer" role="dialog" aria-modal="true" aria-labelledby="pd-title" aria-hidden="true">
  <div class="drawer-h">
    <div class="pthumb" id="pd-thumb"></div>
    <div class="grow"><div class="strong" id="pd-title" style="font-size:16px"></div><div class="muted small" id="pd-meta"></div></div>
    <a class="btn btn-sm" id="pd-view" target="_blank" rel="noopener">View</a>
    <button type="button" class="btn btn-sm btn-ghost" id="pd-close" aria-label="Close">✕</button>
  </div>
  <div class="drawer-b">
    <form id="pd-form" class="stack" autocomplete="off">
      <section>
        <div class="lbl" style="margin-bottom:6px">In the store</div>
        <div class="card" style="padding:4px 16px;box-shadow:none">
          <div class="toggle-row"><div><div class="t">Visible</div><div class="d">Off hides it from the whole store.</div></div><label class="switch"><input type="checkbox" id="pd-visible"><span class="track"></span></label></div>
          <div class="toggle-row"><div><div class="t">Featured</div></div><label class="switch"><input type="checkbox" id="pd-featured"><span class="track"></span></label></div>
          <div class="toggle-row"><div><div class="t">Bestseller</div><div class="d">Shown in the homepage Bestsellers.</div></div><label class="switch"><input type="checkbox" id="pd-bestseller"><span class="track"></span></label></div>
        </div>
      </section>
      <section>
        <div class="lbl" style="margin-bottom:6px">Categories</div>
        <div class="catpick" id="pd-cats"></div>
        <% if (!categories.length) { %><div class="hint">No categories yet — <a href="/admin/categories">add some</a> first.</div><% } %>
      </section>
      <section>
        <div class="fld" style="margin:0"><label for="pd-badge">Badge <span class="opt">optional</span></label><input class="input" id="pd-badge" maxlength="24" placeholder="New, Limited, Best loved…"><div class="hint">A small label on the product’s picture in the store.</div></div>
      </section>
      <section class="stack" style="gap:14px">
        <div><div class="lbl">Product text</div><div class="hint">Shown on the product page. What you write here is used instead of Sariee’s; leave a box empty to keep Sariee’s (shown in grey).</div></div>
        <div class="fld" style="margin:0"><label for="pd-details">Details</label><textarea class="textarea" id="pd-details" rows="4" maxlength="3000"></textarea></div>
        <div class="fld" style="margin:0"><label for="pd-how">How to use</label><textarea class="textarea" id="pd-how" rows="4" maxlength="3000"></textarea></div>
        <div class="fld" style="margin:0"><label for="pd-ing">Ingredients</label><textarea class="textarea" id="pd-ing" rows="4" maxlength="3000"></textarea></div>
        <div class="hint">Blank line = new paragraph. Bold, headings and links are not used here.</div>
      </section>
    </form>
  </div>
  <div class="drawer-f"><button type="button" class="btn" id="pd-cancel">Cancel</button><button type="button" class="btn btn-solid" id="pd-save">Save</button></div>
</aside>

<script>window.ADM_PRODUCTS = <%- JSON.stringify({ items: items, categories: categories.map(function (c) { return { slug: c.slug, name: c.name, id: c.id }; }), subcategories: subcategories.map(function (s) { return { slug: s.slug, name: s.name, category_id: s.category_id }; }) }).replace(/</g, '\\u003c') %>;</script>
<%- include('../partials/admin-close') %>
