<%- include('../partials/admin-open') %>
<%
  const ago = function (t) {
    const s = Math.max(1, Math.round((Date.now() - t) / 1000));
    if (s < 60) return 'just now';
    if (s < 3600) return Math.round(s / 60) + ' min ago';
    if (s < 86400) return Math.round(s / 3600) + ' h ago';
    const d = Math.round(s / 86400); return d === 1 ? 'yesterday' : d + ' days ago';
  };
  const ICON = {
    star: '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>',
    tag: '<path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="7.5" cy="8.5" r="1.2"/>',
    bag: '<path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/>',
    layout: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/>',
    ok: '<path d="M20 6 9 17l-5-5"/>',
  };
  const hour = new Date().getHours();
  const greet = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
%>
<div class="hello">
  <h1><%= greet %>, <%= user.first_name || 'there' %>.</h1>
  <p>Everything about how the store looks and reads is managed here. Products, orders and customers live in your Sariee dashboard.</p>
  <div class="row wrap">
    <a class="btn btn-warm" href="/admin/homepage">Edit the homepage</a>
    <a class="btn" href="/admin/products">Manage products</a>
    <a class="btn" href="/" target="_blank" rel="noopener">View the store</a>
  </div>
</div>

<div class="grid g4" style="margin-bottom:20px">
  <div class="card stat"><div class="k">Products on the store</div><div class="v"><%= stats.visible %></div><div class="s"><%= stats.hidden %> hidden · <%= stats.products %> in Sariee</div></div>
  <div class="card stat"><div class="k">Bestsellers</div><div class="v"><%= stats.bestsellers %></div><div class="s">shown on the homepage</div></div>
  <div class="card stat"><div class="k">Categories</div><div class="v"><%= stats.categories %></div><div class="s">in the store menu</div></div>
  <div class="card stat"><div class="k">Reviews</div><div class="v"><%= stats.published %></div><div class="s"><%= stats.pending %> waiting</div></div>
</div>

<div class="grid split">
  <div class="stack">
    <section class="card card-pad">
      <div class="card-h"><div><h2 class="card-t">Needs your attention</h2><p class="card-d">Small things that make the store feel finished.</p></div></div>
      <% if (!todos.length) { %>
        <div class="todo is-ok"><div class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><%- ICON.ok %></svg></div><div class="grow"><div class="strong">All clear</div><div class="muted small">Nothing is waiting on you right now.</div></div></div>
      <% } %>
      <% todos.forEach(function (t) { %>
        <div class="todo">
          <div class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><%- ICON[t.icon] || ICON.tag %></svg></div>
          <div class="grow"><div class="strong"><%= t.title %></div><div class="muted small"><%= t.detail %></div></div>
          <a class="btn btn-sm" href="<%= t.href %>"><%= t.cta %></a>
        </div>
      <% }); %>
    </section>

    <section class="card card-pad">
      <div class="card-h"><div><h2 class="card-t">Jump in</h2></div></div>
      <div class="grid g3">
        <a class="quick" href="/admin/homepage#hero"><b>Hero &amp; headline</b><span>Image, title and button</span></a>
        <a class="quick" href="/admin/settings#announcement"><b>Announcement bar</b><span>A message above the header</span></a>
        <a class="quick" href="/admin/homepage#sections"><b>Homepage sections</b><span>Show, hide, reword</span></a>
        <a class="quick" href="/admin/products?filter=nocat"><b>Uncategorised</b><span>Give products a home</span></a>
        <a class="quick" href="/admin/pages"><b>Pages &amp; policies</b><span>About, shipping, refunds</span></a>
        <a class="quick" href="/admin/settings#sound"><b>Entrance &amp; sound</b><span>First impressions</span></a>
      </div>
    </section>
  </div>

  <div class="stack">
    <section class="card card-pad">
      <div class="card-h"><div><h2 class="card-t">Store status</h2></div></div>
      <div class="toggle-row" style="border-top:0;padding-top:0"><div><div class="t"><span class="dot <%= sarieeError ? 'bad' : 'ok' %>"></span> Sariee connection</div><div class="d"><%= sarieeError ? 'Not responding right now.' : 'Products are loading normally.' %></div></div></div>
      <div class="toggle-row"><div><div class="t"><span class="dot <%= announcement.enabled && announcement.text ? 'ok' : '' %>"></span> Announcement bar</div><div class="d"><%= announcement.enabled && announcement.text ? '“' + announcement.text + '”' : 'Off.' %></div></div><a class="btn btn-sm" href="/admin/settings#announcement">Edit</a></div>
      <div class="toggle-row"><div><div class="t"><span class="dot <%= site.intro_enabled ? 'ok' : '' %>"></span> Entrance animation</div><div class="d"><%= site.intro_enabled ? 'Plays once per visit on the homepage.' : 'Off.' %></div></div><a class="btn btn-sm" href="/admin/settings#entrance">Edit</a></div>
      <div class="toggle-row"><div><div class="t"><span class="dot <%= site.sound_default ? 'ok' : '' %>"></span> Ambient sound</div><div class="d"><%= site.sound_default ? 'On by default; visitors can switch it off.' : 'Off by default; visitors can switch it on.' %></div></div><a class="btn btn-sm" href="/admin/settings#sound">Edit</a></div>
    </section>

    <section class="card card-pad">
      <div class="card-h"><div><h2 class="card-t">Recent changes</h2><p class="card-d">The last things edited in this admin.</p></div></div>
      <% if (!recent.length) { %><p class="muted small" style="margin:0">Nothing yet. Edits you make will show up here.</p><% } %>
      <ul class="feed">
        <% recent.forEach(function (r) { %><li><span><b><%= r.who %></b> · <%= r.text %></span><time datetime="<%= new Date(r.t).toISOString() %>"><%= ago(r.t) %></time></li><% }); %>
      </ul>
    </section>
  </div>
</div>
<%- include('../partials/admin-close') %>
