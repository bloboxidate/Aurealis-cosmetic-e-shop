<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%
  const inp = 'width:100%;padding:10px 12px;border-radius:8px;border:1px solid rgba(58,53,46,.25);font-size:14px;background:#fff;box-sizing:border-box';
  const lbl = 'display:block;font-size:11px;font-weight:700;color:#6b6357;text-transform:uppercase;letter-spacing:.05em;margin:14px 0 5px';
  // field defs per page: [name, label, type]  (type: text | textarea | rich | policy;
  // rich/policy get the formatting toolbar and are rendered with lib/richtext.js)
  const pages = [
    ['home', 'Home page', [
      ['hero_eyebrow','Hero eyebrow','text'],['hero_title','Hero title','text'],
      ['hero_text','Hero paragraph','textarea'],['hero_cta','Hero button label','text'],
      ['bestsellers_title','Bestsellers heading','text'],['bestsellers_text','Bestsellers subtext','text'],
    ], { field: 'hero_image', label: 'Hero image' }],
    ['about', 'About page', [
      ['eyebrow','Eyebrow','text'],['title','Title','text'],['body','Body','policy'],
    ], { field: 'image', label: 'Our Story image (shown on the About page and the home page)' }],
    ['shop', 'Shop page', [
      ['title','Heading (when no category selected)','text'],['intro','Intro line','rich'],
    ]],
    ['shipping', 'Shipping Policy page', [
      ['title','Page title','text'],['intro','Intro line (under the title)','rich'],
      ['body','Policy text','policy'],
    ]],
    ['refund', 'Refund Policy page', [
      ['title','Page title','text'],['intro','Intro line (under the title)','rich'],
      ['body','Policy text','policy'],
    ]],
    ['contact', 'Contact Us page', [
      ['title','Page title','text'],['intro','Intro text','rich'],
      ['email','Email shown on the page (blank = use the footer email)','text'],
      ['phone','Phone number shown on the page (blank = use the footer phone)','text'],
      ['hours','Opening hours (optional)','textarea'],['address','Address (optional)','textarea'],
      ['extra','Extra text below the details (optional)','policy'],
    ]],
    ['footer', 'Footer & contact', [
      ['tagline','Tagline','textarea'],['email','Contact email','text'],['phone','Phone','text'],
      ['instagram','Instagram URL','text'],['tiktok','TikTok URL','text'],['copyright','Copyright line','text'],
    ]],
  ];
%>
<style>
  .rt-toolbar{display:flex;flex-wrap:wrap;gap:6px;padding:8px;background:#f6f1e9;border:1px solid rgba(58,53,46,.25);border-bottom:none;border-radius:8px 8px 0 0}
  .rt-toolbar button{border:1px solid rgba(58,53,46,.2);background:#fff;border-radius:6px;padding:5px 11px;font-size:13px;cursor:pointer;color:#3a352e}
  .rt-toolbar button:hover{background:#f8ae7f}
</style>
<div class="admin-shell" style="display:flex;min-height:100vh;background:#fbf7f1">
  <%- include('../partials/admin-nav', { adminActive }) %>
  <div class="admin-main" style="flex:1;padding:40px 48px;max-width:720px">
    <div class="serif" style="font-size:36px;margin-bottom:8px">Page Content</div>
    <div style="font-size:14px;color:#8a8175;margin-bottom:16px">Edit the copy shown across your storefront. Changes go live immediately.</div>
    <div style="font-size:13px;margin-bottom:24px;line-height:2">Jump to:
      <% pages.forEach(function(pg){ %><a href="#page-<%= pg[0] %>" style="margin-right:12px;color:#c1602f"><%= pg[1] %></a><% }); %>
    </div>
    <%- include('../partials/flash') %>

    <% pages.forEach(function(pg){ var key = pg[0]; var c = content[key] || {}; %>
      <form id="page-<%= key %>" method="post" action="/admin/content/<%= key %>" style="scroll-margin-top:20px;background:#fff;border-radius:14px;border:1px solid rgba(58,53,46,.08);padding:24px;margin-bottom:22px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div style="font-size:18px;font-weight:700;margin-bottom:4px"><%= pg[1] %></div>
        <% pg[2].forEach(function(f){ var name=f[0], label=f[1], type=f[2]; var val=(c[name]!==undefined?c[name]:''); %>
          <label style="<%= lbl %>"><%= label %></label>
          <% if (type === 'policy' || type === 'rich') { %>
            <div class="rt-toolbar" role="toolbar" aria-label="Formatting">
              <button type="button" data-fmt="bold" title="Bold"><b>B</b></button>
              <button type="button" data-fmt="italic" title="Italic"><i>I</i></button>
              <button type="button" data-fmt="h2" title="Heading">H<small>2</small></button>
              <button type="button" data-fmt="h3" title="Sub-heading">H<small>3</small></button>
              <button type="button" data-fmt="ul" title="Bulleted list">&bull; List</button>
              <button type="button" data-fmt="link" title="Link">Link</button>
              <button type="button" data-fmt="para" title="Start a new paragraph">&para; New paragraph</button>
            </div>
            <textarea name="<%= name %>" rows="<%= type === 'policy' ? 16 : 5 %>" class="rt-area" style="<%= inp %>;resize:vertical;line-height:1.5;font-size:14px;border-top-left-radius:0;border-top-right-radius:0"><%= val %></textarea>
            <div style="font-size:12px;color:#8a8175;margin-top:6px;line-height:1.6">Select text and use the buttons above, or type: blank line = new paragraph · <code>## Heading</code> · <code>- bullet</code> (one per line) · <code>**bold**</code> · <code>*italic*</code> · <code>[link text](https://…)</code></div>
          <% } else if (type === 'textarea') { %>
            <textarea name="<%= name %>" rows="4" style="<%= inp %>;resize:vertical"><%= val %></textarea>
          <% } else { %>
            <input name="<%= name %>" value="<%= val %>" style="<%= inp %>">
          <% } %>
        <% }); %>
        <div style="margin-top:18px"><button type="submit" class="btn-primary" style="padding:11px 26px">Save <%= pg[1] %></button></div>
      </form>

      <% if (pg[3]) { %>
        <% var imgVal = c[pg[3].field] || ''; %>
        <div class="image-upload" data-key="<%= key %>" data-field="<%= pg[3].field %>" style="background:#fff;border-radius:14px;border:1px solid rgba(58,53,46,.08);padding:24px;margin-bottom:22px">
          <label style="<%= lbl %>;margin-top:0"><%= pg[3].label %></label>
          <img class="image-upload-preview" src="<%= imgVal %>" style="width:160px;height:100px;object-fit:cover;border-radius:10px;margin-bottom:10px;display:<%= imgVal ? 'block' : 'none' %>;background:#f0ece5">
          <input type="file" accept="image/*" class="image-upload-input">
          <div class="image-upload-status" style="font-size:12px;color:#8a8175;margin-top:6px"></div>
        </div>
      <% } %>
    <% }); %>
  </div>
</div>
<script>
// Formatting toolbar: wraps the selection (or inserts a placeholder) with the
// light markup lib/richtext.js understands.
document.querySelectorAll('.rt-toolbar').forEach(function (bar) {
  var ta = bar.nextElementSibling;
  function edit(fn) {
    var s = ta.selectionStart, e = ta.selectionEnd, v = ta.value;
    var r = fn(v.slice(0, s), v.slice(s, e), v.slice(e));
    ta.value = r.text;
    ta.focus();
    ta.setSelectionRange(r.start, r.end);
  }
  function wrap(mark, ph) {
    edit(function (b, sel, a) {
      var t = sel || ph;
      return { text: b + mark + t + mark + a, start: b.length + mark.length, end: b.length + mark.length + t.length };
    });
  }
  // Heading / list formats prefix every line touched by the selection.
  function prefix(pre, ph) {
    edit(function (b, sel, a) {
      var head = b.slice(0, b.lastIndexOf('\n') + 1);
      var lead = b.slice(head.length);
      var rest = a.indexOf('\n') < 0 ? a : a.slice(0, a.indexOf('\n'));
      var tail = a.slice(rest.length);
      var block = lead + sel + rest;
      if (!block.trim()) block = ph; // empty line: insert a placeholder
      var out = block.split('\n').map(function (l) {
        return pre + l.replace(/^(#{2,3}\s+|[-\u2022]\s+)/, '');
      }).join('\n');
      return { text: head + out + tail, start: head.length + pre.length, end: head.length + out.length };
    });
  }
  bar.addEventListener('click', function (ev) {
    var btn = ev.target.closest('button[data-fmt]');
    if (!btn) return;
    var f = btn.dataset.fmt;
    if (f === 'bold') wrap('**', 'bold text');
    else if (f === 'italic') wrap('*', 'italic text');
    else if (f === 'h2') prefix('## ', 'Heading');
    else if (f === 'h3') prefix('### ', 'Sub-heading');
    else if (f === 'ul') prefix('- ', 'List item');
    else if (f === 'link') {
      edit(function (b, sel, a) {
        var label = sel || 'link text', url = 'https://';
        var pos = b.length + label.length + 3;
        return { text: b + '[' + label + '](' + url + ')' + a, start: pos, end: pos + url.length };
      });
    } else if (f === 'para') {
      edit(function (b, sel, a) {
        var ins = !b || /\n\n$/.test(b) ? '' : (/\n$/.test(b) ? '\n' : '\n\n');
        var pos = b.length + ins.length;
        return { text: b + ins + sel + a, start: pos, end: pos + sel.length };
      });
    }
  });
});
document.querySelectorAll('.image-upload').forEach(function (box) {
  var input = box.querySelector('.image-upload-input');
  var preview = box.querySelector('.image-upload-preview');
  var status = box.querySelector('.image-upload-status');
  var csrfToken = <%- JSON.stringify(csrfToken) %>;
  input.addEventListener('change', function () {
    var file = input.files[0];
    if (!file) return;
    var fd = new FormData();
    fd.append('image', file);
    status.textContent = 'Uploading…';
    fetch('/admin/content/' + box.dataset.key + '/image', {
      method: 'POST',
      headers: { 'X-CSRF-Token': csrfToken },
      body: fd,
    }).then(function (r) { return r.json(); }).then(function (data) {
      if (data.ok) {
        preview.src = data.url;
        preview.style.display = 'block';
        status.textContent = 'Saved.';
      } else {
        status.textContent = data.message || 'Upload failed.';
      }
    }).catch(function () { status.textContent = 'Upload failed.'; });
  });
});
</script>
</body>
</html>
