<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<% const mini='background:none;border:none;color:#c1602f;font-weight:700;cursor:pointer;font-size:13px';
   const del='background:none;border:none;color:#b0533a;cursor:pointer;font-size:13px'; %>
<div class="admin-shell" style="display:flex;min-height:100vh;background:#fbf7f1">
  <%- include('../partials/admin-nav', { adminActive }) %>
  <div class="admin-main" style="flex:1;padding:40px 48px;max-width:820px">
    <div class="serif" style="font-size:36px;margin-bottom:8px">Reviews</div>
    <div style="font-size:14px;color:#8a8175;margin-bottom:24px">Pending reviews awaiting approval before they show on product pages.</div>
    <%- include('../partials/flash') %>

    <% if (pending.length === 0) { %>
      <div style="background:#fff;border-radius:14px;border:1px solid rgba(58,53,46,.08);padding:28px;color:#8a8175;font-size:14px">No pending reviews.</div>
    <% } %>

    <% pending.forEach(function(r){ %>
      <div style="background:#fff;border-radius:14px;border:1px solid rgba(58,53,46,.08);padding:22px;margin-bottom:16px">
        <div style="font-size:13px;color:#8a8175;margin-bottom:6px">Product <%= r.sariee_product_id %> · <%= r.email %> · <%= r.created_at %></div>
        <div style="font-size:14px;font-weight:700;margin-bottom:6px"><%= '★'.repeat(r.rating) %><span style="color:#d8d0c4"><%= '★'.repeat(5 - r.rating) %></span></div>
        <div style="font-size:14px;color:#5a5148;margin-bottom:14px"><%= r.body %></div>
        <div style="display:flex;gap:16px">
          <form action="/admin/reviews/<%= r.id %>/approve" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" style="<%= mini %>">Approve</button></form>
          <form action="/admin/reviews/<%= r.id %>/reject" method="post" onsubmit="return confirm('Reject and delete this review?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" style="<%= del %>">Reject</button></form>
        </div>
      </div>
    <% }); %>
  </div>
</div>
</body>
</html>
