<%- include('../partials/admin-open') %>
<%
  const list = tab === 'published' ? published : pending;
  const when = function (d) { try { return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); } catch (e) { return ''; } };
  const who = function (e) { return String(e || '').replace(/^(.{2}).*(@.*)$/, '$1•••$2'); };
%>
<div class="adm-head">
  <div>
    <h1 class="adm-h1">Reviews</h1>
    <p class="adm-sub">Reviews wait here until you approve them. Only approved reviews appear on product pages and the homepage, and only the reviewer’s first name is ever shown.</p>
  </div>
</div>

<nav class="tabs" aria-label="Review status">
  <a href="/admin/reviews?tab=pending" class="<%= tab === 'pending' ? 'is-on' : '' %>">Waiting <span class="pill <%= pending.length ? 'warn' : '' %>"><%= pending.length %></span></a>
  <a href="/admin/reviews?tab=published" class="<%= tab === 'published' ? 'is-on' : '' %>">Published <span class="pill"><%= published.length %></span></a>
</nav>

<div style="max-width:860px">
  <% if (!list.length) { %>
    <div class="card empty">
      <div class="big"><%= tab === 'pending' ? 'Nothing waiting' : 'No published reviews yet' %></div>
      <div><%= tab === 'pending' ? 'New reviews will appear here for you to approve.' : 'Approve a review and it will show up here.' %></div>
    </div>
  <% } %>
  <% list.forEach(function (r) { var n = names[String(r.sariee_product_id)]; %>
    <article class="card rev">
      <div class="row wrap between">
        <div>
          <div class="strong"><% if (n) { %><a href="/product/<%= encodeURIComponent(n.slug) %>" target="_blank" rel="noopener" style="color:inherit;text-decoration:none"><%= n.name %></a><% } else { %>Product <%= r.sariee_product_id %><% } %></div>
          <div class="muted small"><%= who(r.email) %> · <%= when(r.created_at) %></div>
        </div>
        <div class="stars" role="img" aria-label="<%= r.rating %> out of 5"><%= '★'.repeat(r.rating) %><i><%= '★'.repeat(5 - r.rating) %></i></div>
      </div>
      <q><%= r.body %></q>
      <div class="row wrap">
        <% if (tab === 'pending') { %>
          <form method="post" action="/admin/reviews/<%= r.id %>/approve" data-ajax data-reload><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm btn-solid">Approve</button></form>
          <form method="post" action="/admin/reviews/<%= r.id %>/reject" data-ajax data-reload data-confirm="This deletes the review for good." data-confirm-title="Delete this review?" data-confirm-yes="Delete" data-danger><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm btn-danger">Delete</button></form>
        <% } else { %>
          <form method="post" action="/admin/reviews/<%= r.id %>/unpublish" data-ajax data-reload data-confirm="It will disappear from the store and go back to the waiting list." data-confirm-title="Unpublish this review?" data-confirm-yes="Unpublish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm">Unpublish</button></form>
          <form method="post" action="/admin/reviews/<%= r.id %>/reject" data-ajax data-reload data-confirm="This deletes the review for good." data-confirm-title="Delete this review?" data-confirm-yes="Delete" data-danger><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm btn-danger">Delete</button></form>
        <% } %>
      </div>
    </article>
  <% }); %>
</div>
<%- include('../partials/admin-close') %>
