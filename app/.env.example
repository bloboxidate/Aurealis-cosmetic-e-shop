# Copy this file to `.env` and fill in your values.

# --- Database ---
# Leave DATABASE_URL unset to use the local SQLite file (default, zero setup).
# To use Supabase/Postgres, paste your connection string here.
# In Supabase: Project Settings → Database → Connection string → "URI".
#
# REQUIRED on Vercel (or any serverless host): use the "Connection pooling"
# (Transaction mode, port 6543) string below, NOT the direct connection
# (port 5432). Every cold start creates a new connection pool, and Vercel can
# run many instances at once — pointed at the direct connection, this
# exhausts Supabase's connection limit under real traffic ("max clients
# reached" / EMAXCONNSESSION, taking the whole site down). The pooler is
# built to absorb exactly this.
# Example:
# DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Session ---
# Set a long random string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string

# --- Server ---
PORT=3000
# Set to "production" when deployed (enables secure cookies). Vercel sets this
# automatically.
NODE_ENV=development

# --- Admin login (used by `npm run seed` to create the first admin) ---
ADMIN_EMAIL=admin@aurealis.test
ADMIN_PASSWORD=change-this-admin-password

# --- Sariee API integration ---
SARIEE_API_BASE_URL=https://api.sariee.com
# The store domain — sent as the x-domain header. Without it the API returns
# 412 "Attempt to read property company_id on null".
SARIEE_STORE_DOMAIN=aurealis.sariee.shop
SARIEE_REQUEST_REFERER=https://aurealis.sariee.shop
SARIEE_LOCALE=en

# Admin/company-portal auth — pick ONE (only needed for /api/company/* calls):
#
# OPTION A (recommended — no token to manage): your Sariee company-portal login.
# The client logs in via POST /api/company/auth/login, caches the rotating
# access_token in memory, and re-logs-in when it expires.
SARIEE_LOGIN_EMAIL=
SARIEE_LOGIN_PASSWORD=
#
# OPTION B: a static bearer token from Sariee (leave Option A blank if using it).
SARIEE_API_BEARER_TOKEN=

# Per-request timeout in milliseconds.
SARIEE_TIMEOUT_MS=20000

# --- Transactional email (optional) ---
# Without SMTP_HOST set, emails (order confirmation, password reset,
# cancellation requests) are only logged to the server console, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Auréalis <no-reply@aurealis.example>"

# Inbox that receives customer cancellation requests (Sariee has no cancel
# API, so these must be actioned manually). Without this set, requests are
# still recorded locally but not emailed anywhere.
STORE_OPS_EMAIL=

# --- Admin JSON proxy (optional) ---
# /api/sariee/admin/call/:id lets an admin session invoke any documented
# Sariee company endpoint. GET (read-only) endpoints are always allowed;
# mutating ones (POST/PUT/PATCH/DELETE) need their id listed here.
SARIEE_ADMIN_PROXY_ALLOW=
